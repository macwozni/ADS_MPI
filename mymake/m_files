# Deprecated compatibility view of the hierarchical source manifests.
#
# New builds must use src/GNUmakefile and the problem-local GNUmakefiles.  The
# variables below remain available to read-only legacy tooling, but no source
# list is maintained in mymake anymore.

_ADS_M_FILES_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
_ADS_ROOT_DIR := $(abspath $(_ADS_M_FILES_DIR)/..)
_ADS_CONFIG_PATH := $(abspath $(if $(CONFIG),$(CONFIG),$(_ADS_ROOT_DIR)/m_options))

include $(_ADS_ROOT_DIR)/src/sources.mk
include $(_ADS_ROOT_DIR)/problems/problems.mk

SOURCES = $(addprefix $(_ADS_ROOT_DIR)/src/,$(SRC_FILES))

define _ADS_PROBLEM_SOURCES
$(addprefix $(_ADS_ROOT_DIR)/problems/$($(1)_DIR)/,$(shell \
	$(MAKE) --no-print-directory -s -C $(_ADS_ROOT_DIR)/problems/$($(1)_DIR) \
	CONFIG="$(_ADS_CONFIG_PATH)" list-sources))
endef

L2 = $(call _ADS_PROBLEM_SOURCES,l2)
HEAT = $(call _ADS_PROBLEM_SOURCES,heat)
ERIKSSON = $(call _ADS_PROBLEM_SOURCES,eriksson)
PURE_DIFFUSION_IGRM = $(call _ADS_PROBLEM_SOURCES,pure_diffusion_igrm)
OIL = $(call _ADS_PROBLEM_SOURCES,oil)
IGRM_L2 = $(call _ADS_PROBLEM_SOURCES,igrm_l2)
IGRM_HEAT = $(call _ADS_PROBLEM_SOURCES,igrm_heat)
IGRM_EIRKSSON = $(call _ADS_PROBLEM_SOURCES,igrm_eirksson)
IGRM_STOKES = $(call _ADS_PROBLEM_SOURCES,igrm_stokes)
IGRM_POLLUTION = $(call _ADS_PROBLEM_SOURCES,igrm_pollution)
