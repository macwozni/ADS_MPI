

###########################################################
# This file is included in the makefile
# These may/should be modified to fit available compiler
# and computer configuration
###########################################################


###########################################################
#     select directories
###########################################################

MUMPS_DIR = /opt/lib/MUMPS_5.8.2/
LAPACK_DIR = /opt/lib/lapack-3.12.1/lib64
SCALAPACK_DIR = /opt/lib/scalapack-2.3.2/lib64
BLAS_DIR = /opt/lib/lapack-3.12.1/lib64
PARMETIS_DIR = /opt/lib/parmetis/lib
METIS_DIR = /opt/lib/metis/lib
GKLIB_DIR = /opt/lib/GKlib/lib64



###########################################################
#     options for compiler
###########################################################

COMPILER = /opt/lib/mpich-5.0.0/bin/mpif90
DIALECT = -std=f2003  -fimplicit-none -cpp -pthread -fopenmp  -pedantic
BOUNDS = -fbounds-check
RELEASE_OPTS = -funroll-all-loops -O3 
DEBUG_OPTS = -O0 -g -fcheck=all $(BOUNDS) -fsanitize=address
# -fbacktrace -ffpe-trap=zero,overflow,underflow



###########################################################
#     options for compiler
###########################################################

INCLUDE = -I$(MUMPS_DIR)/include/ -I$(PARMETIS_DIR)/include
FF		= $(COMPILER) $(DIALECT) $(DEBUG_OPTS) $(INCLUDE)
FPP		= fpp -O3

###########################################################
#     libs
###########################################################

BLAS_LIB      = $(BLAS_DIR)/libblas.a
LAPACK_LIB    = $(LAPACK_DIR)/liblapack.a
SCALAPACK_LIB = $(SCALAPACK_DIR)/libscalapack.a
METIS_LIB     = $(METIS_DIR)/libmetis.a $(GKLIB_DIR)/libGKlib.a
PARMETIS_LIB  = $(PARMETIS_DIR)/libparmetis.a
MUMPS_LIB     = $(MUMPS_DIR)/lib/libdmumps.a $(MUMPS_DIR)/lib/libmumps_common.a $(MUMPS_DIR)/lib/libpord.a



USER_LIB      = $(MUMPS_LIB) $(LAPACK_LIB) $(SCALAPACK_LIB) $(PARMETIS_LIB) $(METIS_LIB) $(BLAS_LIB)
