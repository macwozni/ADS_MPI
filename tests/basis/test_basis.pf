module test_basis
   use pfunit
   implicit none

   real(kind=8), parameter :: tol = 128.0d0*epsilon(1.0d0)

contains

   subroutine assert_vector_near(actual, expected, tolerance)
      use math, only: norm_2
      real(kind=8), intent(in) :: actual(:), expected(:)
      real(kind=8), intent(in) :: tolerance

      @assertEqual(size(expected), size(actual))
      @assertTrue(norm_2(actual - expected) <= tolerance)
   end subroutine assert_vector_near


   pure real(kind=8) function greville(U, p, basis_index) result(value)
      real(kind=8), intent(in) :: U(0:)
      integer(kind=4), intent(in) :: p, basis_index

      value = sum(U(basis_index + 1:basis_index + p))/real(p, kind=8)
   end function greville


   pure real(kind=8) function polynomial_value(x, y, z) result(value)
      real(kind=8), intent(in) :: x, y, z

      value = 1.0d0 + 2.0d0*x - 3.0d0*y + 0.5d0*z + 4.0d0*x*y*z
   end function polynomial_value


   @test
   subroutine test_find_span_handles_nonuniform_knots_and_boundaries()
      use basis, only: FindSpan
      integer(kind=4), parameter :: n = 4, p = 2
      real(kind=8) :: U(0:n + p + 1)

      U = (/0.0d0, 0.0d0, 0.0d0, 0.2d0, 0.7d0, 1.0d0, 1.0d0, 1.0d0/)

      @assertEqual(p, FindSpan(n, p, -0.1d0, U))
      @assertEqual(p, FindSpan(n, p, 0.0d0, U))
      @assertEqual(2, FindSpan(n, p, 0.199d0, U))
      @assertEqual(3, FindSpan(n, p, 0.2d0, U))
      @assertEqual(3, FindSpan(n, p, 0.5d0, U))
      @assertEqual(4, FindSpan(n, p, 0.7d0, U))
      @assertEqual(n, FindSpan(n, p, 1.0d0, U))
      @assertEqual(n, FindSpan(n, p, 1.1d0, U))
   end subroutine test_find_span_handles_nonuniform_knots_and_boundaries


   @test
   subroutine test_find_span_skips_repeated_internal_knots()
      use basis, only: FindSpan
      integer(kind=4), parameter :: n = 5, p = 2
      real(kind=8) :: U(0:n + p + 1)

      U = (/0.0d0, 0.0d0, 0.0d0, 0.5d0, 0.5d0, 0.8d0, 1.0d0, 1.0d0, 1.0d0/)

      @assertEqual(2, FindSpan(n, p, 0.25d0, U))
      @assertEqual(4, FindSpan(n, p, 0.5d0, U))
      @assertEqual(4, FindSpan(n, p, 0.75d0, U))
      @assertEqual(5, FindSpan(n, p, 0.8d0, U))
      @assertEqual(5, FindSpan(n, p, 0.95d0, U))
   end subroutine test_find_span_skips_repeated_internal_knots


   @test
   subroutine test_basis_count_spans_skips_repeated_knots()
      use basis, only: BasisCountSpans => CountSpans
      use knot_vector, only: KnotCountSpans => CountSpans
      integer(kind=4), parameter :: n = 6, p = 3
      real(kind=8) :: U(0:n + p + 1)

      U = (/0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.25d0, 0.5d0, 0.5d0, &
            1.0d0, 1.0d0, 1.0d0, 1.0d0/)

      @assertEqual(3, BasisCountSpans(n, p, U))
      @assertEqual(KnotCountSpans(n, p, U), BasisCountSpans(n, p, U))
   end subroutine test_basis_count_spans_skips_repeated_knots


   @test
   subroutine test_linear_basis_values_and_first_derivatives()
      use basis, only: DersBasisFuns
      integer(kind=4), parameter :: p = 1, d = 1, span = 1
      real(kind=8) :: U(0:3), ders(0:p, 0:d)
      real(kind=8) :: expected_values(0:p), expected_derivatives(0:p)

      U = (/0.0d0, 0.0d0, 1.0d0, 1.0d0/)
      expected_values = (/0.75d0, 0.25d0/)
      expected_derivatives = (/-1.0d0, 1.0d0/)

      call DersBasisFuns(span, 0.25d0, p, d, U, ders)

      call assert_vector_near(ders(:, 0), expected_values, tol)
      call assert_vector_near(ders(:, 1), expected_derivatives, tol)
   end subroutine test_linear_basis_values_and_first_derivatives


   @test
   subroutine test_quadratic_bernstein_values_and_derivatives()
      use basis, only: DersBasisFuns
      integer(kind=4), parameter :: p = 2, d = 2, span = 2
      real(kind=8) :: U(0:5), ders(0:p, 0:d)
      real(kind=8) :: expected_values(0:p), expected_first(0:p), expected_second(0:p)

      U = (/0.0d0, 0.0d0, 0.0d0, 1.0d0, 1.0d0, 1.0d0/)
      expected_values = (/0.5625d0, 0.375d0, 0.0625d0/)
      expected_first = (/-1.5d0, 1.0d0, 0.5d0/)
      expected_second = (/2.0d0, -4.0d0, 2.0d0/)

      call DersBasisFuns(span, 0.25d0, p, d, U, ders)

      call assert_vector_near(ders(:, 0), expected_values, tol)
      call assert_vector_near(ders(:, 1), expected_first, tol)
      call assert_vector_near(ders(:, 2), expected_second, tol)
   end subroutine test_quadratic_bernstein_values_and_derivatives


   @test
   subroutine test_basis_partition_properties_with_repeated_knots()
      use basis, only: DersBasisFuns, FindSpan
      integer(kind=4), parameter :: n = 6, p = 3, d = 2
      real(kind=8), parameter :: points(6) = &
         (/0.1d0, 0.25d0, 0.49d0, 0.5d0, 0.75d0, 1.0d0/)
      real(kind=8) :: U(0:n + p + 1), ders(0:p, 0:d)
      integer(kind=4) :: i, span

      U = (/0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.25d0, 0.5d0, 0.5d0, &
            1.0d0, 1.0d0, 1.0d0, 1.0d0/)

      do i = 1, size(points)
         span = FindSpan(n, p, points(i), U)
         call DersBasisFuns(span, points(i), p, d, U, ders)
         @assertTrue(abs(sum(ders(:, 0)) - 1.0d0) <= tol)
         @assertTrue(abs(sum(ders(:, 1))) <= 4.0d0*tol)
         @assertTrue(abs(sum(ders(:, 2))) <= 16.0d0*tol)
      end do
   end subroutine test_basis_partition_properties_with_repeated_knots


   @test
   subroutine test_basis_data_maps_nonuniform_elements_and_integrates_moments()
      use basis, only: BasisData
      integer(kind=4), parameter :: p = 1, m = 4, d = 1, q = 2, r = 2
      real(kind=8) :: U(0:m), J(r), W(q), X(q, r)
      real(kind=8) :: N(0:d, 0:p, q, r)
      integer(kind=4) :: O(r), e, iq
      real(kind=8) :: h, left, integral_zero, integral_x, integral_x2

      U = (/0.0d0, 0.0d0, 0.25d0, 1.0d0, 1.0d0/)

      call BasisData(p, m, U, d, q, r, O, J, W, X, N)

      @assertTrue(all(O == (/0, 1/)))
      call assert_vector_near(J, (/0.125d0, 0.375d0/), tol)
      call assert_vector_near(W, (/1.0d0, 1.0d0/), tol)

      do e = 1, r
         left = U(O(e) + p)
         h = U(O(e) + p + 1) - left
         do iq = 1, q
            @assertTrue(X(iq, e) > left)
            @assertTrue(X(iq, e) < left + h)
            @assertTrue(abs(N(0, 0, iq, e) - (left + h - X(iq, e))/h) <= tol)
            @assertTrue(abs(N(0, 1, iq, e) - (X(iq, e) - left)/h) <= tol)
            @assertTrue(abs(N(1, 0, iq, e) + 1.0d0/h) <= tol)
            @assertTrue(abs(N(1, 1, iq, e) - 1.0d0/h) <= tol)
         end do
      end do

      integral_zero = 0.0d0
      integral_x = 0.0d0
      integral_x2 = 0.0d0
      do e = 1, r
         integral_zero = integral_zero + J(e)*sum(W)
         integral_x = integral_x + J(e)*sum(W*X(:, e))
         integral_x2 = integral_x2 + J(e)*sum(W*X(:, e)**2)
      end do
      @assertTrue(abs(integral_zero - 1.0d0) <= tol)
      @assertTrue(abs(integral_x - 0.5d0) <= tol)
      @assertTrue(abs(integral_x2 - 1.0d0/3.0d0) <= tol)
   end subroutine test_basis_data_maps_nonuniform_elements_and_integrates_moments


   @test
   subroutine test_basis_data_offsets_ignore_zero_length_spans()
      use basis, only: BasisData
      integer(kind=4), parameter :: p = 2, m = 7, d = 1, q = 3, r = 2
      real(kind=8) :: U(0:m), J(r), W(q), X(q, r)
      real(kind=8) :: N(0:d, 0:p, q, r)
      integer(kind=4) :: O(r), e, iq

      U = (/0.0d0, 0.0d0, 0.0d0, 0.5d0, 0.5d0, 1.0d0, 1.0d0, 1.0d0/)

      call BasisData(p, m, U, d, q, r, O, J, W, X, N)

      @assertTrue(all(O == (/0, 2/)))
      call assert_vector_near(J, (/0.25d0, 0.25d0/), tol)
      @assertTrue(abs(sum(W) - 2.0d0) <= tol)
      do e = 1, r
         do iq = 1, q
            @assertTrue(abs(sum(N(0, :, iq, e)) - 1.0d0) <= tol)
            @assertTrue(abs(sum(N(1, :, iq, e))) <= 4.0d0*tol)
         end do
      end do
   end subroutine test_basis_data_offsets_ignore_zero_length_spans


   @test
   subroutine test_basis_data_is_independent_of_openmp_thread_count()
      use basis, only: BasisData
      use omp_lib, only: omp_set_dynamic, omp_set_num_threads
      integer(kind=4), parameter :: p = 3, m = 10, d = 2, q = 4, r = 4
      real(kind=8) :: U(0:m)
      integer(kind=4) :: O1(r), O4(r)
      real(kind=8) :: J1(r), J4(r), W1(q), W4(q), X1(q, r), X4(q, r)
      real(kind=8) :: N1(0:d, 0:p, q, r), N4(0:d, 0:p, q, r)

      U = (/0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.2d0, 0.5d0, 0.8d0, &
            1.0d0, 1.0d0, 1.0d0, 1.0d0/)

      call omp_set_dynamic(.false.)
      call omp_set_num_threads(1)
      call BasisData(p, m, U, d, q, r, O1, J1, W1, X1, N1)
      call omp_set_num_threads(4)
      call BasisData(p, m, U, d, q, r, O4, J4, W4, X4, N4)

      @assertTrue(all(O1 == O4))
      @assertTrue(all(J1 == J4))
      @assertTrue(all(W1 == W4))
      @assertTrue(all(X1 == X4))
      @assertTrue(all(N1 == N4))
   end subroutine test_basis_data_is_independent_of_openmp_thread_count


   @test
   subroutine test_eval_spline_preserves_constant_at_knots_and_boundaries()
      use basis, only: EvalSpline
      integer(kind=4), parameter :: n = 4, p = 2, nelem = 2
      real(kind=8) :: U(0:n + p + 1)
      real(kind=8) :: coeffs(0:n, 0:n, 0:n)
      real(kind=8) :: value

      U = (/0.0d0, 0.0d0, 0.0d0, 0.5d0, 0.5d0, 1.0d0, 1.0d0, 1.0d0/)
      coeffs = 3.25d0

      value = EvalSpline(0, U, p, n, nelem, U, p, n, nelem, U, p, n, nelem, &
                         coeffs, 0.0d0, 0.0d0, 0.0d0)
      @assertTrue(abs(value - 3.25d0) <= tol)
      value = EvalSpline(0, U, p, n, nelem, U, p, n, nelem, U, p, n, nelem, &
                         coeffs, 0.5d0, 0.5d0, 0.5d0)
      @assertTrue(abs(value - 3.25d0) <= tol)
      value = EvalSpline(0, U, p, n, nelem, U, p, n, nelem, U, p, n, nelem, &
                         coeffs, 1.0d0, 1.0d0, 1.0d0)
      @assertTrue(abs(value - 3.25d0) <= tol)
      value = EvalSpline(0, U, p, n, nelem, U, p, n, nelem, U, p, n, nelem, &
                         coeffs, 0.2d0, 0.8d0, 0.4d0)
      @assertTrue(abs(value - 3.25d0) <= tol)
   end subroutine test_eval_spline_preserves_constant_at_knots_and_boundaries


   @test
   subroutine test_eval_spline_reproduces_nonuniform_polynomial()
      use basis, only: EvalSpline
      integer(kind=4), parameter :: nx = 2, px = 1, nelemx = 2
      integer(kind=4), parameter :: ny = 3, py = 2, nelemy = 2
      integer(kind=4), parameter :: nz = 4, pz = 3, nelemz = 2
      real(kind=8) :: Ux(0:nx + px + 1), Uy(0:ny + py + 1), Uz(0:nz + pz + 1)
      real(kind=8) :: coeffs(0:nx, 0:ny, 0:nz)
      real(kind=8) :: points(3, 6), actual, expected
      integer(kind=4) :: ix, iy, iz, ip

      Ux = (/0.0d0, 0.0d0, 0.3d0, 1.0d0, 1.0d0/)
      Uy = (/0.0d0, 0.0d0, 0.0d0, 0.4d0, 1.0d0, 1.0d0, 1.0d0/)
      Uz = (/0.0d0, 0.0d0, 0.0d0, 0.0d0, 0.6d0, 1.0d0, 1.0d0, 1.0d0, 1.0d0/)

      do iz = 0, nz
         do iy = 0, ny
            do ix = 0, nx
               coeffs(ix, iy, iz) = polynomial_value( &
                  greville(Ux, px, ix), greville(Uy, py, iy), greville(Uz, pz, iz))
            end do
         end do
      end do

      points(:, 1) = (/0.0d0, 0.0d0, 0.0d0/)
      points(:, 2) = (/1.0d0, 1.0d0, 1.0d0/)
      points(:, 3) = (/0.3d0, 0.4d0, 0.6d0/)
      points(:, 4) = (/0.1d0, 0.2d0, 0.3d0/)
      points(:, 5) = (/0.65d0, 0.75d0, 0.85d0/)
      points(:, 6) = (/0.9d0, 0.15d0, 0.55d0/)

      do ip = 1, size(points, 2)
         actual = EvalSpline(0, &
            Ux, px, nx, nelemx, Uy, py, ny, nelemy, Uz, pz, nz, nelemz, &
            coeffs, points(1, ip), points(2, ip), points(3, ip))
         expected = polynomial_value(points(1, ip), points(2, ip), points(3, ip))
         @assertTrue(abs(actual - expected) <= 16.0d0*tol)
      end do
   end subroutine test_eval_spline_reproduces_nonuniform_polynomial


   @test
   subroutine test_eval_spline_mixed_first_derivative()
      use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
      use basis, only: EvalSpline
      integer(kind=4), parameter :: n = 1, p = 1, nelem = 1
      real(kind=8) :: U(0:n + p + 1), coeffs(0:n, 0:n, 0:n), actual
      integer(kind=4) :: ix, iy, iz

      U = (/0.0d0, 0.0d0, 1.0d0, 1.0d0/)
      do iz = 0, n
         do iy = 0, n
            do ix = 0, n
               coeffs(ix, iy, iz) = real(ix*iy*iz, kind=8)
            end do
         end do
      end do

      actual = EvalSpline(1, U, p, n, nelem, U, p, n, nelem, U, p, n, nelem, &
                          coeffs, 0.2d0, 0.4d0, 0.7d0)

      @assertTrue(ieee_is_finite(actual))
      @assertTrue(abs(actual - 1.0d0) <= tol)
   end subroutine test_eval_spline_mixed_first_derivative


   @test
   subroutine test_eval_spline_mixed_second_derivative()
      use basis, only: EvalSpline
      integer(kind=4), parameter :: n = 2, p = 2, nelem = 1
      real(kind=8) :: U(0:n + p + 1), coeffs(0:n, 0:n, 0:n), actual

      U = (/0.0d0, 0.0d0, 0.0d0, 1.0d0, 1.0d0, 1.0d0/)
      coeffs = 0.0d0
      coeffs(2, 2, 2) = 1.0d0

      actual = EvalSpline(2, U, p, n, nelem, U, p, n, nelem, U, p, n, nelem, &
                          coeffs, 0.2d0, 0.4d0, 0.7d0)

      ! coeffs represent x^2*y^2*z^2 in the quadratic Bernstein basis.
      @assertTrue(abs(actual - 8.0d0) <= 32.0d0*tol)
   end subroutine test_eval_spline_mixed_second_derivative

end module test_basis
