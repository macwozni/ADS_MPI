      call BackwardEuler3DStep(scheme, 67, sample_forcing, ads_test, ads_trial, ads_data, &
                               71, mierr, sample_rhs_point)

      call assert_multistep_delegation(scheme, ads_test%n, ads_trial%n, 67, 71, 1.75d0, .true., mierr)
   end subroutine test_backward_euler_step_delegates_rhs_point


   subroutine assert_multistep_delegation(scheme, test_n, trial_n, iter, history_index, &
                                          expected_time, expect_rhs_point, mierr)
      type(TimeScheme3D), intent(in) :: scheme
      integer(kind=4), intent(in) :: test_n(3), trial_n(3), iter, history_index, mierr
      real(kind=8), intent(in) :: expected_time
      logical, intent(in) :: expect_rhs_point

      @assertTrue(step_call_count == 0)
      @assertTrue(multistep_call_count == 1)
      @assertTrue(recorded_iter == iter)
      @assertTrue(recorded_history_index == history_index)
      @assertTrue(all(recorded_test_space_n == test_n))
      @assertTrue(all(recorded_trial_space_n == trial_n))
      @assertTrue(recorded_rhs_point_present .eqv. expect_rhs_point)
      @assertTrue(abs(recorded_ads_time - expected_time) <= tol)
      @assertTrue(recorded_lhs_mix_present)
      @assertTrue(recorded_rhs_du_state_present)
      @assertTrue(maxval(abs(recorded_mix - scheme%mix)) <= tol)
      @assertTrue(maxval(abs(recorded_alpha_step - scheme%alpha_step)) <= tol)
      @assertTrue(maxval(abs(recorded_lhs_mix - scheme%lhs_mix)) <= tol)
      @assertTrue(all(recorded_rhs_du_state == scheme%rhs_du_state))
      @assertTrue(abs(recorded_forcing_value - 64.0d0) <= tol)
      if (expect_rhs_point) then
         @assertTrue(abs(recorded_rhs_point_value - 65.0d0) <= tol)
      else
         @assertTrue(abs(recorded_rhs_point_value) <= tol)
      end if
      @assertTrue(mierr == MULTISTEP_STATUS)
   end subroutine assert_multistep_delegation

end module test_time_scheme
