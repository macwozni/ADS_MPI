module test_igrm_pollution_input_data
   use pfunit
   use input_data, only: DOMAIN_MIN, DOMAIN_LENGTH, DOMAIN_MAX, TIME_STEP, &
                         DT, DIFFUSION, WIND_SPEED, SOURCE_CENTER, &
                         SOURCE_RADIUS, MAX_POLYNOMIAL_DEGREE, &
                         DEFAULT_OUTPUT_RESOLUTION, SplineDofs, &
                         adapted_coordinate, emission, wind_at_time
   implicit none

   real(kind=8), parameter :: TOL = 1024.d0*epsilon(1.d0)

contains

   logical function close_enough(actual, expected, tolerance) result(close)
      real(kind=8), intent(in) :: actual, expected
      real(kind=8), intent(in), optional :: tolerance
      real(kind=8) :: selected_tolerance

      selected_tolerance = TOL
      if (present(tolerance)) selected_tolerance = tolerance
      close = abs(actual - expected) <= &
              selected_tolerance*max(1.d0, abs(expected))
   end function close_enough


   @test
   subroutine test_reference_constants()
      @assertTrue(DOMAIN_MIN == 0.d0)
      @assertTrue(DOMAIN_LENGTH == 5000.d0)
      @assertTrue(DOMAIN_MAX == 5000.d0)
      @assertTrue(TIME_STEP == 1.8d0)
      @assertTrue(DT == TIME_STEP)
      @assertTrue(all(DIFFUSION == (/ 50.d0, 50.d0, 0.5d0 /)))
      @assertTrue(WIND_SPEED == 5.d0)
      @assertTrue(all(SOURCE_CENTER == (/ 3000.d0, 2000.d0, 2000.d0 /)))
      @assertTrue(SOURCE_RADIUS == 25.d0)
      @assertEqual(9, MAX_POLYNOMIAL_DEGREE)
      @assertEqual(100, DEFAULT_OUTPUT_RESOLUTION)
   end subroutine test_reference_constants


   @test
   subroutine test_spline_dof_formula_covers_continuous_and_broken_spaces()
      @assertTrue(SplineDofs(4, 2, 1) == 6_8)
      @assertTrue(SplineDofs(4, 3, 2) == 7_8)
      @assertTrue(SplineDofs(4, 3, 1) == 10_8)
      @assertTrue(SplineDofs(4, 3, 0) == 13_8)
      @assertTrue(SplineDofs(4, 3, -1) == 16_8)
      @assertTrue(SplineDofs(1, 9, -1) == 10_8)
   end subroutine test_spline_dof_formula_covers_continuous_and_broken_spaces


   @test
   subroutine test_adapted_coordinate_matches_upstream_piecewise_mesh()
      @assertTrue(adapted_coordinate(0.d0) == 0.d0)
      @assertTrue(close_enough(adapted_coordinate(0.25d0), 2475.d0))
      @assertTrue(close_enough(adapted_coordinate(0.5d0), 4950.d0))
      @assertTrue(close_enough(adapted_coordinate(0.75d0), 4975.d0))
      @assertTrue(close_enough(adapted_coordinate(1.d0), 5000.d0))
   end subroutine test_adapted_coordinate_matches_upstream_piecewise_mesh


   @test
   subroutine test_emission_has_independent_radial_oracles()
      real(kind=8) :: X(3)

      X = SOURCE_CENTER
      @assertTrue(emission(X) == 1.d0)

      X = SOURCE_CENTER
      X(1) = X(1) + SOURCE_RADIUS/2.d0
      @assertTrue(close_enough(emission(X), 0.87890625d0))

      X = SOURCE_CENTER
      X(1) = X(1) + SOURCE_RADIUS/sqrt(2.d0)
      @assertTrue(close_enough(emission(X), 0.5625d0))

      X = SOURCE_CENTER
      X(2) = X(2) + SOURCE_RADIUS
      @assertTrue(emission(X) == 0.d0)
      X(2) = X(2) + 1.d0
      @assertTrue(emission(X) == 0.d0)
   end subroutine test_emission_has_independent_radial_oracles


   @test
   subroutine test_emission_is_spherically_symmetric()
      real(kind=8) :: X(3), values(3)
      integer(kind=4) :: direction

      do direction = 1, 3
         X = SOURCE_CENTER
         X(direction) = X(direction) - 7.d0
         values(direction) = emission(X)
      end do
      @assertTrue(close_enough(values(1), values(2)))
      @assertTrue(close_enough(values(2), values(3)))
   end subroutine test_emission_is_spherically_symmetric


   @test
   subroutine test_wind_at_zero_uses_corrected_uniform_law()
      real(kind=8) :: wind(3)

      wind = wind_at_time(0.d0)
      @assertTrue(close_enough(wind(1), 1.9134171618254492d0))
      @assertTrue(close_enough(wind(2), 4.619397662556434d0))
      @assertTrue(wind(3) == 0.d0)
      @assertTrue(close_enough(wind(1)*wind(1) + wind(2)*wind(2), 25.d0))
   end subroutine test_wind_at_zero_uses_corrected_uniform_law


   @test
   subroutine test_wind_time_dependence_has_independent_oracle()
      real(kind=8) :: wind(3)

      wind = wind_at_time(150.d0)
      @assertTrue(close_enough(wind(1), -3.8503077022953947d0))
      @assertTrue(close_enough(wind(2), 3.1898480524383532d0))
      @assertTrue(close_enough(wind(3), 1.4024516413464942d0))
      @assertTrue(close_enough(wind(1)*wind(1) + wind(2)*wind(2), 25.d0))

      wind = wind_at_time(1.8d0)
      @assertTrue(close_enough(wind(1), 1.7879385219045045d0))
      @assertTrue(close_enough(wind(2), 4.66939780291741d0))
      @assertTrue(close_enough(wind(3), 0.019999520003455992d0))
   end subroutine test_wind_time_dependence_has_independent_oracle

end module test_igrm_pollution_input_data
