module test_sparse
   use pfunit
   use sparse
   implicit none

   real(kind=8), parameter :: tol = 1.0d-15

contains

   subroutine assert_real_close(actual, expected, eps)
      real(kind=8), intent(in) :: actual, expected, eps
      @assertTrue(abs(actual - expected) <= eps)
   end subroutine assert_real_close


   subroutine assert_dense_equals(actual, expected, eps)
      real(kind=8), intent(in) :: actual(:, :), expected(:, :), eps
      integer :: i, j

      @assertTrue(size(expected, 1) == size(actual, 1))
      @assertTrue(size(expected, 2) == size(actual, 2))

      do j = lbound(expected, 2), ubound(expected, 2)
         do i = lbound(expected, 1), ubound(expected, 1)
            @assertTrue(abs(actual(i, j) - expected(i, j)) <= eps)
         end do
      end do
   end subroutine assert_dense_equals


   subroutine initialize_mumps_triplets(mumps_par)
      include 'dmumps_struc.h'
      type(dmumps_struc), intent(out) :: mumps_par

      nullify(mumps_par%irn)
      nullify(mumps_par%jcn)
      nullify(mumps_par%a)
   end subroutine initialize_mumps_triplets


   @test
   subroutine test_initialize_sparse_creates_empty_matrix()
      type(sparse_matrix), pointer :: matrix

      call initialize_sparse(4, 7, matrix)

      @assertTrue(associated(matrix))
      @assertTrue(matrix%x == 4)
      @assertTrue(matrix%y == 7)
      @assertTrue(matrix%total_entries == 0_8)

      call clear_matrix(matrix)
   end subroutine test_initialize_sparse_creates_empty_matrix


   @test
   subroutine test_initialize_sparse_accepts_zero_dimensions()
      type(sparse_matrix), pointer :: matrix

      call initialize_sparse(0, 0, matrix)

      @assertTrue(associated(matrix))
      @assertTrue(matrix%x == 0)
      @assertTrue(matrix%y == 0)
      @assertTrue(matrix%total_entries == 0_8)

      call clear_matrix(matrix)
   end subroutine test_initialize_sparse_accepts_zero_dimensions


   @test
   subroutine test_add_creates_first_entry()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:3, 0:3)
      real(kind=8) :: ref(0:3, 0:3)

      call initialize_sparse(4, 4, matrix)
      call add(matrix, 1, 2, 7.5d0)

      @assertTrue(matrix%total_entries == 1_8)

      call to_dense_matrix(matrix, dense)
      ref = 0.0d0
      ref(1, 2) = 7.5d0
      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_add_creates_first_entry


   @test
   subroutine test_add_accumulates_repeated_entry_in_dense_export()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:3, 0:3)
      real(kind=8) :: ref(0:3, 0:3)

      call initialize_sparse(4, 4, matrix)
      call add(matrix, 1, 1, 2.5d0)
      call add(matrix, 1, 1, -0.5d0)

      @assertTrue(matrix%total_entries == 1_8)

      call to_dense_matrix(matrix, dense)
      ref = 0.0d0
      ref(1, 1) = 2.0d0
      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_add_accumulates_repeated_entry_in_dense_export


   @test
   subroutine test_add_zero_still_creates_entry()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:3, 0:3)
      real(kind=8) :: ref(0:3, 0:3)

      call initialize_sparse(4, 4, matrix)
      call add(matrix, 2, 3, 0.0d0)

      @assertTrue(matrix%total_entries == 1_8)

      call to_dense_matrix(matrix, dense)
      ref = 0.0d0
      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_add_zero_still_creates_entry


   @test
   subroutine test_add_multiple_entries_and_total_entries()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:5, 0:5)
      real(kind=8) :: ref(0:5, 0:5)

      call initialize_sparse(6, 6, matrix)
      call add(matrix, 1, 1, 1.0d0)
      call add(matrix, 1, 2, 2.0d0)
      call add(matrix, 1, 1, 3.0d0)
      call add(matrix, 4, 0, 5.0d0)
      call add(matrix, 4, 0, -2.0d0)

      @assertTrue(matrix%total_entries == 3_8)

      call to_dense_matrix(matrix, dense)

      ref = 0.0d0
      ref(1, 1) = 4.0d0
      ref(1, 2) = 2.0d0
      ref(4, 0) = 3.0d0

      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_add_multiple_entries_and_total_entries


   @test
   subroutine test_add_handles_zero_indices()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:2, 0:2)
      real(kind=8) :: ref(0:2, 0:2)

      call initialize_sparse(3, 3, matrix)
      call add(matrix, 0, 0, 9.0d0)

      @assertTrue(matrix%total_entries == 1_8)

      call to_dense_matrix(matrix, dense)
      ref = 0.0d0
      ref(0, 0) = 9.0d0

      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_add_handles_zero_indices


   @test
   subroutine test_add_preserves_multiple_rows_and_columns()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:9, 0:9)
      real(kind=8) :: ref(0:9, 0:9)

      call initialize_sparse(10, 10, matrix)

      call add(matrix, 9, 9, 1.0d0)
      call add(matrix, 0, 5, 2.0d0)
      call add(matrix, 9, 1, 3.0d0)
      call add(matrix, 4, 4, 4.0d0)
      call add(matrix, 4, 2, 5.0d0)
      call add(matrix, 0, 0, 6.0d0)
      call add(matrix, 4, 7, 7.0d0)

      @assertTrue(matrix%total_entries == 7_8)

      call to_dense_matrix(matrix, dense)

      ref = 0.0d0
      ref(9, 9) = 1.0d0
      ref(0, 5) = 2.0d0
      ref(9, 1) = 3.0d0
      ref(4, 4) = 4.0d0
      ref(4, 2) = 5.0d0
      ref(0, 0) = 6.0d0
      ref(4, 7) = 7.0d0

      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_add_preserves_multiple_rows_and_columns


   @test
   subroutine test_add_existing_accumulates_without_changing_pattern()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:2, 0:2)
      real(kind=8) :: ref(0:2, 0:2)

      call initialize_sparse(3, 3, matrix)
      call add(matrix, 1, 2, 0.0d0)

      call add_existing(matrix, 1, 2, 2.5d0)
      call add_existing(matrix, 1, 2, -0.5d0)

      @assertTrue(matrix%total_entries == 1_8)

      call to_dense_matrix(matrix, dense)
      ref = 0.0d0
      ref(1, 2) = 2.0d0
      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_add_existing_accumulates_without_changing_pattern


   @test
   subroutine test_add_existing_missing_entry_fails()
      use iso_c_binding, only: c_int
      type(sparse_matrix), pointer :: matrix
      integer(c_int) :: child, waited, child_status

      interface
         function c_fork() bind(C, name='fork') result(pid)
            import :: c_int
            integer(c_int) :: pid
         end function c_fork

         function c_waitpid(pid, status, options) bind(C, name='waitpid') result(waited_pid)
            import :: c_int
            integer(c_int), value :: pid
            integer(c_int), intent(out) :: status
            integer(c_int), value :: options
            integer(c_int) :: waited_pid
         end function c_waitpid
      end interface

      call initialize_sparse(2, 2, matrix)
      child = c_fork()

      if (child == 0_c_int) then
         call add_existing(matrix, 1, 1, 3.0d0)
         stop 0
      end if

      @assertTrue(child > 0_c_int)
      waited = c_waitpid(child, child_status, 0_c_int)
      @assertEqual(child, waited)
      @assertEqual(0_c_int, iand(child_status, 127_c_int))
      @assertEqual(1_c_int, iand(shiftr(child_status, 8), 255_c_int))

      call clear_matrix(matrix)
   end subroutine test_add_existing_missing_entry_fails


   @test
   subroutine test_row_capacity_growth_preserves_9_and_17_entries()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:0, 0:16)
      integer(kind=4) :: col

      call initialize_sparse(1, 17, matrix)

      do col = 8, 0, -1
         call add(matrix, 0, col, real(col + 1, kind=8))
      end do

      @assertTrue(matrix%total_entries == 9_8)
      call to_dense_matrix(matrix, dense)
      do col = 0, 8
         call assert_real_close(dense(0, col), real(col + 1, kind=8), tol)
      end do
      @assertTrue(all(dense(0, 9:16) == 0.0d0))

      do col = 16, 9, -1
         call add(matrix, 0, col, real(col + 1, kind=8))
      end do

      @assertTrue(matrix%total_entries == 17_8)
      call to_dense_matrix(matrix, dense)
      do col = 0, 16
         call assert_real_close(dense(0, col), real(col + 1, kind=8), tol)
      end do

      call clear_matrix(matrix)
   end subroutine test_row_capacity_growth_preserves_9_and_17_entries


   @test
   subroutine test_clear_matrix_on_null_pointer_is_safe()
      type(sparse_matrix), pointer :: matrix

      matrix => null()
      call clear_matrix(matrix)

      @assertFalse(associated(matrix))
   end subroutine test_clear_matrix_on_null_pointer_is_safe


   @test
   subroutine test_clear_matrix_deallocates_nonempty_structure()
      type(sparse_matrix), pointer :: matrix

      call initialize_sparse(5, 5, matrix)
      call add(matrix, 0, 0, 1.0d0)
      call add(matrix, 1, 2, 2.0d0)
      call add(matrix, 4, 4, 3.0d0)

      call clear_matrix(matrix)

      @assertFalse(associated(matrix))
   end subroutine test_clear_matrix_deallocates_nonempty_structure


   @test
   subroutine test_clear_matrix_twice_is_safe()
      type(sparse_matrix), pointer :: matrix

      call initialize_sparse(2, 2, matrix)
      call add(matrix, 1, 1, 3.0d0)

      call clear_matrix(matrix)
      call clear_matrix(matrix)

      @assertFalse(associated(matrix))
   end subroutine test_clear_matrix_twice_is_safe


   @test
   subroutine test_to_dense_matrix_for_empty_matrix_returns_zeros()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:2, 0:3)
      real(kind=8) :: ref(0:2, 0:3)

      call initialize_sparse(3, 4, matrix)

      call to_dense_matrix(matrix, dense)

      ref = 0.0d0
      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_to_dense_matrix_for_empty_matrix_returns_zeros


   @test
   subroutine test_to_dense_matrix_single_entry()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:3, 0:2)
      real(kind=8) :: ref(0:3, 0:2)

      call initialize_sparse(4, 3, matrix)
      call add(matrix, 2, 1, 9.25d0)
      call to_dense_matrix(matrix, dense)

      ref = 0.0d0
      ref(2, 1) = 9.25d0

      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_to_dense_matrix_single_entry


   @test
   subroutine test_to_dense_matrix_multiple_entries_rectangular()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:2, 0:4)
      real(kind=8) :: ref(0:2, 0:4)

      call initialize_sparse(3, 5, matrix)
      call add(matrix, 0, 0, 1.0d0)
      call add(matrix, 2, 4, -3.5d0)
      call add(matrix, 1, 3, 8.0d0)
      call add(matrix, 2, 1, 2.25d0)

      call to_dense_matrix(matrix, dense)

      ref = 0.0d0
      ref(0, 0) = 1.0d0
      ref(2, 4) = -3.5d0
      ref(1, 3) = 8.0d0
      ref(2, 1) = 2.25d0

      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_to_dense_matrix_multiple_entries_rectangular


   @test
   subroutine test_to_dense_matrix_overwrites_old_dense_contents()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:1, 0:1)
      real(kind=8) :: ref(0:1, 0:1)

      call initialize_sparse(2, 2, matrix)
      call add(matrix, 1, 0, 4.0d0)

      dense = 777.0d0
      call to_dense_matrix(matrix, dense)

      ref = 0.0d0
      ref(1, 0) = 4.0d0

      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_to_dense_matrix_overwrites_old_dense_contents


   @test
   subroutine test_to_dense_matrix_preserves_explicit_zero_entries()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:1, 0:2)
      real(kind=8) :: ref(0:1, 0:2)

      call initialize_sparse(2, 3, matrix)
      call add(matrix, 0, 2, 0.0d0)
      call add(matrix, 1, 1, 5.0d0)

      call to_dense_matrix(matrix, dense)

      ref = 0.0d0
      ref(1, 1) = 5.0d0

      call assert_dense_equals(dense, ref, tol)
      @assertTrue(matrix%total_entries == 2_8)

      call clear_matrix(matrix)
   end subroutine test_to_dense_matrix_preserves_explicit_zero_entries


   @test
   subroutine test_to_dense_matrix_accumulates_duplicate_entries()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:2, 0:2)
      real(kind=8) :: ref(0:2, 0:2)

      call initialize_sparse(3, 3, matrix)
      call add(matrix, 1, 2, 1.0d0)
      call add(matrix, 1, 2, 2.5d0)
      call add(matrix, 1, 2, -0.5d0)

      call to_dense_matrix(matrix, dense)

      ref = 0.0d0
      ref(1, 2) = 3.0d0

      call assert_dense_equals(dense, ref, tol)
      @assertTrue(matrix%total_entries == 1_8)

      call clear_matrix(matrix)
   end subroutine test_to_dense_matrix_accumulates_duplicate_entries


   @test
   subroutine test_to_mumps_format_empty_matrix()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(3, 5, matrix)
      call to_mumps_format(matrix, mumps_par)

      @assertTrue(mumps_par%N == 5)
      @assertTrue(mumps_par%NZ == 0)
      @assertTrue(size(mumps_par%irn) == 0)
      @assertTrue(size(mumps_par%jcn) == 0)
      @assertTrue(size(mumps_par%a) == 0)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_empty_matrix


   @test
   subroutine test_to_mumps_format_uses_max_dimension_as_N()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(7, 4, matrix)
      call add(matrix, 6, 3, 1.0d0)
      call to_mumps_format(matrix, mumps_par)

      @assertTrue(mumps_par%N == 7)
      @assertTrue(mumps_par%NZ == 1)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_uses_max_dimension_as_N


   @test
   subroutine test_to_mumps_format_single_entry_is_one_based()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(4, 4, matrix)
      call add(matrix, 0, 0, 11.0d0)
      call to_mumps_format(matrix, mumps_par)

      @assertTrue(mumps_par%NZ == 1)
      @assertTrue(mumps_par%irn(1) == 1)
      @assertTrue(mumps_par%jcn(1) == 1)
      call assert_real_close(mumps_par%a(1), 11.0d0, tol)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_single_entry_is_one_based


   @test
   subroutine test_to_mumps_format_preserves_sparse_traversal_order()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(6, 6, matrix)
      call add(matrix, 4, 2, 4.2d0)
      call add(matrix, 1, 5, 1.5d0)
      call add(matrix, 1, 2, 1.2d0)
      call add(matrix, 3, 0, -7.0d0)

      call to_mumps_format(matrix, mumps_par)

      @assertTrue(mumps_par%NZ == 4)

      @assertTrue(mumps_par%irn(1) == 2)
      @assertTrue(mumps_par%jcn(1) == 3)
      call assert_real_close(mumps_par%a(1), 1.2d0, tol)

      @assertTrue(mumps_par%irn(2) == 2)
      @assertTrue(mumps_par%jcn(2) == 6)
      call assert_real_close(mumps_par%a(2), 1.5d0, tol)

      @assertTrue(mumps_par%irn(3) == 4)
      @assertTrue(mumps_par%jcn(3) == 1)
      call assert_real_close(mumps_par%a(3), -7.0d0, tol)

      @assertTrue(mumps_par%irn(4) == 5)
      @assertTrue(mumps_par%jcn(4) == 3)
      call assert_real_close(mumps_par%a(4), 4.2d0, tol)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_preserves_sparse_traversal_order


   @test
   subroutine test_to_mumps_format_rectangular_matrix()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(2, 5, matrix)
      call add(matrix, 1, 4, 3.0d0)
      call add(matrix, 0, 2, -8.0d0)

      call to_mumps_format(matrix, mumps_par)

      @assertTrue(mumps_par%N == 5)
      @assertTrue(mumps_par%NZ == 2)

      @assertTrue(mumps_par%irn(1) == 1)
      @assertTrue(mumps_par%jcn(1) == 3)
      call assert_real_close(mumps_par%a(1), -8.0d0, tol)

      @assertTrue(mumps_par%irn(2) == 2)
      @assertTrue(mumps_par%jcn(2) == 5)
      call assert_real_close(mumps_par%a(2), 3.0d0, tol)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_rectangular_matrix


   @test
   subroutine test_to_mumps_format_accumulates_duplicate_entries()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(5, 5, matrix)
      call add(matrix, 2, 3, 1.0d0)
      call add(matrix, 2, 3, 4.5d0)
      call add(matrix, 2, 3, -0.5d0)

      call to_mumps_format(matrix, mumps_par)

      @assertTrue(mumps_par%NZ == 1)
      @assertTrue(mumps_par%irn(1) == 3)
      @assertTrue(mumps_par%jcn(1) == 4)
      call assert_real_close(mumps_par%a(1), 5.0d0, tol)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_accumulates_duplicate_entries


   @test
   subroutine test_repeated_mumps_export_replaces_previous_triplets()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(2, 3, matrix)
      call add(matrix, 0, 2, 2.0d0)
      call add(matrix, 1, 0, 4.0d0)

      call to_mumps_format(matrix, mumps_par)
      @assertTrue(mumps_par%NZ == 2)
      @assertTrue(all(mumps_par%irn == (/1, 2/)))
      @assertTrue(all(mumps_par%jcn == (/3, 1/)))
      @assertTrue(all(mumps_par%a == (/2.0d0, 4.0d0/)))

      call add_existing(matrix, 0, 2, 3.0d0)
      call add(matrix, 0, 1, 7.0d0)
      call to_mumps_format(matrix, mumps_par)

      @assertTrue(mumps_par%N == 3)
      @assertTrue(mumps_par%NZ == 3)
      @assertTrue(all(mumps_par%irn == (/1, 1, 2/)))
      @assertTrue(all(mumps_par%jcn == (/2, 3, 1/)))
      @assertTrue(all(mumps_par%a == (/7.0d0, 5.0d0, 4.0d0/)))

      call to_mumps_format_transposed(matrix, mumps_par)
      @assertTrue(mumps_par%NZ == 3)
      @assertTrue(all(mumps_par%irn == (/2, 3, 1/)))
      @assertTrue(all(mumps_par%jcn == (/1, 1, 2/)))
      @assertTrue(all(mumps_par%a == (/7.0d0, 5.0d0, 4.0d0/)))

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_repeated_mumps_export_replaces_previous_triplets


   @test
   subroutine test_to_mumps_format_transposed_empty_matrix()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(2, 7, matrix)
      call to_mumps_format_transposed(matrix, mumps_par)

      @assertTrue(mumps_par%N == 7)
      @assertTrue(mumps_par%NZ == 0)
      @assertTrue(size(mumps_par%irn) == 0)
      @assertTrue(size(mumps_par%jcn) == 0)
      @assertTrue(size(mumps_par%a) == 0)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_transposed_empty_matrix


   @test
   subroutine test_to_mumps_format_transposed_swaps_indices_and_is_one_based()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(5, 5, matrix)
      call add(matrix, 2, 4, 9.0d0)

      call to_mumps_format_transposed(matrix, mumps_par)

      @assertTrue(mumps_par%NZ == 1)
      @assertTrue(mumps_par%irn(1) == 5)
      @assertTrue(mumps_par%jcn(1) == 3)
      call assert_real_close(mumps_par%a(1), 9.0d0, tol)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_transposed_swaps_indices_and_is_one_based


   @test
   subroutine test_to_mumps_format_transposed_preserves_traversal_order()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(6, 6, matrix)
      call add(matrix, 4, 2, 4.2d0)
      call add(matrix, 1, 5, 1.5d0)
      call add(matrix, 1, 2, 1.2d0)
      call add(matrix, 3, 0, -7.0d0)

      call to_mumps_format_transposed(matrix, mumps_par)

      @assertTrue(mumps_par%NZ == 4)

      @assertTrue(mumps_par%irn(1) == 3)
      @assertTrue(mumps_par%jcn(1) == 2)
      call assert_real_close(mumps_par%a(1), 1.2d0, tol)

      @assertTrue(mumps_par%irn(2) == 6)
      @assertTrue(mumps_par%jcn(2) == 2)
      call assert_real_close(mumps_par%a(2), 1.5d0, tol)

      @assertTrue(mumps_par%irn(3) == 1)
      @assertTrue(mumps_par%jcn(3) == 4)
      call assert_real_close(mumps_par%a(3), -7.0d0, tol)

      @assertTrue(mumps_par%irn(4) == 3)
      @assertTrue(mumps_par%jcn(4) == 5)
      call assert_real_close(mumps_par%a(4), 4.2d0, tol)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_transposed_preserves_traversal_order


   @test
   subroutine test_to_mumps_format_transposed_uses_max_dimension_as_N()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(3, 9, matrix)
      call add(matrix, 2, 8, -1.0d0)

      call to_mumps_format_transposed(matrix, mumps_par)

      @assertTrue(mumps_par%N == 9)
      @assertTrue(mumps_par%NZ == 1)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_transposed_uses_max_dimension_as_N


   @test
   subroutine test_to_mumps_format_transposed_accumulates_duplicate_entries()
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: mumps_par

      call initialize_mumps_triplets(mumps_par)
      call initialize_sparse(4, 4, matrix)
      call add(matrix, 1, 3, 2.0d0)
      call add(matrix, 1, 3, 5.5d0)
      call add(matrix, 1, 3, -1.5d0)

      call to_mumps_format_transposed(matrix, mumps_par)

      @assertTrue(mumps_par%NZ == 1)
      @assertTrue(mumps_par%irn(1) == 4)
      @assertTrue(mumps_par%jcn(1) == 2)
      call assert_real_close(mumps_par%a(1), 6.0d0, tol)

      deallocate(mumps_par%irn)
      deallocate(mumps_par%jcn)
      deallocate(mumps_par%a)
      call clear_matrix(matrix)
   end subroutine test_to_mumps_format_transposed_accumulates_duplicate_entries


   @test
   subroutine test_state_after_clear_and_reinitialize()
      type(sparse_matrix), pointer :: matrix
      real(kind=8) :: dense(0:1, 0:3)
      real(kind=8) :: ref(0:1, 0:3)

      call initialize_sparse(3, 3, matrix)
      call add(matrix, 1, 1, 5.0d0)
      call clear_matrix(matrix)

      call initialize_sparse(2, 4, matrix)
      call add(matrix, 0, 3, 6.0d0)

      @assertTrue(matrix%x == 2)
      @assertTrue(matrix%y == 4)
      @assertTrue(matrix%total_entries == 1_8)

      call to_dense_matrix(matrix, dense)
      ref = 0.0d0
      ref(0, 3) = 6.0d0
      call assert_dense_equals(dense, ref, tol)

      call clear_matrix(matrix)
   end subroutine test_state_after_clear_and_reinitialize


   @test
   subroutine test_large_mumps_export_is_identical_for_one_and_four_threads()
      use omp_lib, only: omp_set_dynamic, omp_set_num_threads
      include 'dmumps_struc.h'
      type(sparse_matrix), pointer :: matrix
      type(dmumps_struc) :: one_thread, four_threads
      integer(kind=4) :: col, row

      call initialize_mumps_triplets(one_thread)
      call initialize_mumps_triplets(four_threads)
      call initialize_sparse(65, 65, matrix)

      do row = 0, 64
         do col = 64, 0, -1
            call add(matrix, row, col, real(1000*row + col, kind=8))
         end do
      end do

      @assertTrue(matrix%total_entries == 4225_8)

      call omp_set_dynamic(.false.)
      call omp_set_num_threads(1)
      call to_mumps_format(matrix, one_thread)
      call omp_set_num_threads(4)
      call to_mumps_format(matrix, four_threads)

      @assertTrue(one_thread%N == 65)
      @assertTrue(one_thread%NZ == 4225)
      @assertTrue(four_threads%N == one_thread%N)
      @assertTrue(four_threads%NZ == one_thread%NZ)
      @assertTrue(all(four_threads%irn == one_thread%irn))
      @assertTrue(all(four_threads%jcn == one_thread%jcn))
      @assertTrue(all(four_threads%a == one_thread%a))
      @assertTrue(one_thread%irn(1) == 1)
      @assertTrue(one_thread%jcn(1) == 1)
      @assertTrue(one_thread%irn(4225) == 65)
      @assertTrue(one_thread%jcn(4225) == 65)

      deallocate(one_thread%irn)
      deallocate(one_thread%jcn)
      deallocate(one_thread%a)
      deallocate(four_threads%irn)
      deallocate(four_threads%jcn)
      deallocate(four_threads%a)
      call clear_matrix(matrix)
   end subroutine test_large_mumps_export_is_identical_for_one_and_four_threads

end module test_sparse
