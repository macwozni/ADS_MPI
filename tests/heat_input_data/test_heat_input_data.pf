module test_heat_input_data
   use pfunit
   use input_data, only: initial_state
   implicit none

   real(kind=8), parameter :: TOL = 64.d0*epsilon(1.d0)

contains

   logical function close_enough(actual, expected) result(close)
      real(kind=8), intent(in) :: actual, expected

      close = abs(actual - expected) <= TOL*max(1.d0, abs(expected))
   end function close_enough


   @test
   subroutine test_iga_ads_heat_3d_initial_profile_oracles()
      real(kind=8) :: actual, left, right

      @assertTrue(close_enough(initial_state(0.5d0, 0.5d0, 0.5d0), 1.d0))
      actual = initial_state(0.625d0, 0.5d0, 0.5d0)
      @assertTrue(close_enough(actual, 3969.d0/4096.d0))
      actual = initial_state(0.625d0, 0.625d0, 0.625d0)
      @assertTrue(close_enough(actual, 3025.d0/4096.d0))
      @assertTrue(close_enough(initial_state(0.75d0, 0.5d0, 0.5d0), 9.d0/16.d0))
      @assertTrue(initial_state(0.25d0, 0.25d0, 0.5d0) == 0.d0)
      @assertTrue(initial_state(0.d0, 0.d0, 0.d0) == 0.d0)

      left = initial_state(0.375d0, 0.5d0, 0.5d0)
      right = initial_state(0.625d0, 0.5d0, 0.5d0)
      @assertTrue(close_enough(left, right))
   end subroutine test_iga_ads_heat_3d_initial_profile_oracles

end module test_heat_input_data
