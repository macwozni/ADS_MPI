module test_igrm_stokes_rhs_fun
   use pfunit
   use input_data, only: body_force_calls, recorded_X
   use RHS_fun, only: forcing_x, forcing_y, forcing_z
   implicit none

   abstract interface
      function forcing_fun(un, du, X) result(value)
         implicit none
         real(kind=8), intent(in) :: un
         real(kind=8), intent(in) :: du(3)
         real(kind=8), intent(in) :: X(3)
         real(kind=8) :: value
      end function forcing_fun
   end interface

contains

   @before
   subroutine reset_stub()
      body_force_calls = 0
      recorded_X = 0.d0
   end subroutine reset_stub


   @test
   subroutine test_each_callback_delegates_to_matching_force_component()
      real(kind=8) :: X(3), du(3)

      X = (/ 0.25d0, 0.5d0, 0.75d0 /)
      du = (/ 2.d0, 3.d0, 5.d0 /)

      @assertTrue(forcing_x(11.d0, du, X) == 20.5d0)
      @assertEqual(1, body_force_calls)
      @assertTrue(all(recorded_X == X))
      @assertTrue(forcing_y(11.d0, du, X) == 30.25d0)
      @assertEqual(2, body_force_calls)
      @assertTrue(forcing_z(11.d0, du, X) == -4.d0)
      @assertEqual(3, body_force_calls)
   end subroutine test_each_callback_delegates_to_matching_force_component


   @test
   subroutine test_callbacks_conform_to_forcing_fun_interface()
      procedure(forcing_fun), pointer :: callback
      real(kind=8) :: X(3), du(3)

      X = (/ 0.1d0, 0.2d0, 0.3d0 /)
      du = 0.d0
      callback => forcing_x
      @assertTrue(callback(0.d0, du, X) == 18.4d0)
      callback => forcing_y
      @assertTrue(callback(0.d0, du, X) == 30.7d0)
      callback => forcing_z
      @assertTrue(callback(0.d0, du, X) == -4.6d0)
   end subroutine test_callbacks_conform_to_forcing_fun_interface


   @test
   subroutine test_callbacks_ignore_previous_solution_and_gradient()
      real(kind=8) :: X(3), first(3), second(3)

      X = (/ 0.1d0, 0.2d0, 0.3d0 /)
      first(1) = forcing_x(-huge(1.d0), (/ 7.d0, 11.d0, 13.d0 /), X)
      first(2) = forcing_y(-huge(1.d0), (/ 7.d0, 11.d0, 13.d0 /), X)
      first(3) = forcing_z(-huge(1.d0), (/ 7.d0, 11.d0, 13.d0 /), X)
      second(1) = forcing_x(huge(1.d0), (/ -7.d0, -11.d0, -13.d0 /), X)
      second(2) = forcing_y(huge(1.d0), (/ -7.d0, -11.d0, -13.d0 /), X)
      second(3) = forcing_z(huge(1.d0), (/ -7.d0, -11.d0, -13.d0 /), X)

      @assertTrue(all(first == second))
      @assertEqual(6, body_force_calls)
   end subroutine test_callbacks_ignore_previous_solution_and_gradient

end module test_igrm_stokes_rhs_fun
