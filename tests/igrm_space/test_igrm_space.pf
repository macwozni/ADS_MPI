module test_igrm_space
   use pfunit
   use igrm_space, only: ValidateIGRMMesh
   implicit none

contains

   @test
   subroutine test_standard_open_spaces_with_same_mesh()
      real(kind=8) :: U_test(0:6)
      real(kind=8) :: U_trial(0:4)

      U_test = (/ 0.d0, 0.d0, 0.d0, 0.5d0, 1.d0, 1.d0, 1.d0 /)
      U_trial = (/ 0.d0, 0.d0, 0.5d0, 1.d0, 1.d0 /)

      call ValidateIGRMMesh(U_test, 2, 3, 2, U_trial, 1, 2, 2)

      @assertTrue(.true.)
   end subroutine test_standard_open_spaces_with_same_mesh


   @test
   subroutine test_repeated_test_knot_does_not_change_mesh()
      real(kind=8) :: U_test(0:7)
      real(kind=8) :: U_trial(0:4)

      U_test = (/ 0.d0, 0.d0, 0.d0, 0.5d0, 0.5d0, 1.d0, 1.d0, 1.d0 /)
      U_trial = (/ 0.d0, 0.d0, 0.5d0, 1.d0, 1.d0 /)

      call ValidateIGRMMesh(U_test, 2, 4, 2, U_trial, 1, 2, 2)

      @assertTrue(.true.)
   end subroutine test_repeated_test_knot_does_not_change_mesh


   @test
   subroutine test_repeated_trial_knot_does_not_change_mesh()
      real(kind=8) :: U_test(0:8)
      real(kind=8) :: U_trial(0:5)

      U_test = (/ 0.d0, 0.d0, 0.d0, 0.d0, 0.5d0, &
                  1.d0, 1.d0, 1.d0, 1.d0 /)
      U_trial = (/ 0.d0, 0.d0, 0.5d0, 0.5d0, 1.d0, 1.d0 /)

      call ValidateIGRMMesh(U_test, 3, 4, 2, U_trial, 1, 3, 2)

      @assertTrue(.true.)
   end subroutine test_repeated_trial_knot_does_not_change_mesh


   @test
   subroutine test_sub_tolerance_perturbations_are_one_location()
      real(kind=8) :: U_test(0:7)
      real(kind=8) :: U_trial(0:4)

      U_test = (/ 0.d0, 0.d0, 0.d0, &
                  0.5d0 + 2.5d-13, 0.5d0 + 7.5d-13, &
                  1.d0, 1.d0, 1.d0 /)
      U_trial = (/ 0.d0, 0.d0, 0.5d0, 1.d0, 1.d0 /)

      call ValidateIGRMMesh(U_test, 2, 4, 2, U_trial, 1, 2, 2)

      @assertTrue(.true.)
   end subroutine test_sub_tolerance_perturbations_are_one_location


   @test
   subroutine test_multiple_interior_locations_are_compared_in_order()
      real(kind=8) :: U_test(0:10)
      real(kind=8) :: U_trial(0:6)

      U_test = (/ 0.d0, 0.d0, 0.d0, 0.d0, &
                  0.25d0, 0.5d0, 0.75d0, &
                  1.d0, 1.d0, 1.d0, 1.d0 /)
      U_trial = (/ 0.d0, 0.d0, 0.25d0, 0.5d0, 0.75d0, 1.d0, 1.d0 /)

      call ValidateIGRMMesh(U_test, 3, 6, 4, U_trial, 1, 4, 4)

      @assertTrue(.true.)
   end subroutine test_multiple_interior_locations_are_compared_in_order


   @test
   subroutine test_single_element_and_zero_degree_trial()
      real(kind=8) :: U_test(0:3)
      real(kind=8) :: U_trial(0:1)

      U_test = (/ 0.d0, 0.d0, 1.d0, 1.d0 /)
      U_trial = (/ 0.d0, 1.d0 /)

      call ValidateIGRMMesh(U_test, 1, 1, 1, U_trial, 0, 0, 1)

      @assertTrue(.true.)
   end subroutine test_single_element_and_zero_degree_trial

end module test_igrm_space
