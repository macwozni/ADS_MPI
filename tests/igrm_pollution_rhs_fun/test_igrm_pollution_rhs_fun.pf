module test_igrm_pollution_rhs_fun
   use pfunit
   use input_data, only: emission_calls, recorded_X
   use RHS_fun, only: forcing
   implicit none

   abstract interface
      function forcing_fun(un, du, X) result(value)
         implicit none
         real(kind=8), intent(in) :: un
         real(kind=8), intent(in) :: du(3)
         real(kind=8), intent(in) :: X(3)
         real(kind=8) :: value
      end function forcing_fun
   end interface

contains

   @before
   subroutine reset_stub()
      emission_calls = 0
      recorded_X = 0.d0
   end subroutine reset_stub


   @test
   subroutine test_forcing_delegates_to_emission()
      real(kind=8) :: X(3), du(3), actual

      X = (/ 0.25d0, 0.5d0, 0.75d0 /)
      du = (/ 2.d0, 3.d0, 5.d0 /)
      actual = forcing(11.d0, du, X)

      @assertTrue(actual == 20.5d0)
      @assertEqual(1, emission_calls)
      @assertTrue(all(recorded_X == X))
   end subroutine test_forcing_delegates_to_emission


   @test
   subroutine test_forcing_conforms_to_library_callback_shape()
      procedure(forcing_fun), pointer :: callback
      real(kind=8) :: X(3), du(3)

      callback => forcing
      X = (/ 0.1d0, 0.2d0, 0.3d0 /)
      du = 0.d0
      @assertTrue(callback(0.d0, du, X) == 18.4d0)
      @assertEqual(1, emission_calls)
   end subroutine test_forcing_conforms_to_library_callback_shape


   @test
   subroutine test_forcing_is_independent_of_previous_state()
      real(kind=8) :: X(3), first, second

      X = (/ 0.1d0, 0.2d0, 0.3d0 /)
      first = forcing(-huge(1.d0), (/ 7.d0, 11.d0, 13.d0 /), X)
      second = forcing(huge(1.d0), (/ -7.d0, -11.d0, -13.d0 /), X)

      @assertTrue(first == second)
      @assertTrue(first == 18.4d0)
      @assertEqual(2, emission_calls)
   end subroutine test_forcing_is_independent_of_previous_state

end module test_igrm_pollution_rhs_fun
