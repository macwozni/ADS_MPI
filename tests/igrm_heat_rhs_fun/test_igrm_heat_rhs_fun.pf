module test_igrm_heat_rhs_fun
   use pfunit
   use Setup, only: ADS_Setup, ADS_compute_data
   use input_data, only: problem_time => t, initial_state
   use RHS_fun, only: heat_igrm_rhs_point, heat_forcing => forcing
   implicit none

   integer(kind=4), parameter :: A_INDEX(3) = (/ 1, 0, 1 /)
   integer(kind=4), parameter :: E_INDEX(3) = (/ 4, 5, 6 /)
   integer(kind=4), parameter :: K_INDEX(3) = (/ 2, 1, 2 /)
   integer(kind=4), parameter :: DIRECTION(3) = (/ 7, 8, 9 /)
   real(kind=8), parameter :: DU_INPUT(3) = (/ 17.0d0, 19.0d0, 23.0d0 /)
   real(kind=8), parameter :: X_INPUT(3) = (/ 29.0d0, 31.0d0, 37.0d0 /)
   real(kind=8), parameter :: STAGE_VALUES(3) = (/ 41.0d0, 43.0d0, 47.0d0 /)
   real(kind=8), parameter :: TEST_VALUE = 110.0d0
   real(kind=8), parameter :: TEST_DERIVATIVES(3) = (/ 165.0d0, 154.0d0, 130.0d0 /)

   integer(kind=4) :: forcing_calls = 0
   real(kind=8) :: last_forcing_un = 0.0d0
   real(kind=8) :: last_forcing_du(3) = 0.0d0
   real(kind=8) :: last_forcing_X(3) = 0.0d0

contains

   subroutine initialize_fixture(ads, ads_data)
      type(ADS_Setup), intent(out) :: ads
      type(ADS_compute_data), intent(out) :: ads_data

      ads%tau = 0.25d0
      allocate(ads%NNx(0:1, 0:1, 1:2, 3:4))
      allocate(ads%NNy(0:1, 0:1, 1:2, 5:6))
      allocate(ads%NNz(0:1, 0:1, 1:2, 5:6))
      ads%NNx = 0.0d0
      ads%NNy = 0.0d0
      ads%NNz = 0.0d0

      ads%NNx(0, A_INDEX(1), K_INDEX(1), E_INDEX(1)) = 2.0d0
      ads%NNx(1, A_INDEX(1), K_INDEX(1), E_INDEX(1)) = 3.0d0
      ads%NNy(0, A_INDEX(2), K_INDEX(2), E_INDEX(2)) = 5.0d0
      ads%NNy(1, A_INDEX(2), K_INDEX(2), E_INDEX(2)) = 7.0d0
      ads%NNz(0, A_INDEX(3), K_INDEX(3), E_INDEX(3)) = 11.0d0
      ads%NNz(1, A_INDEX(3), K_INDEX(3), E_INDEX(3)) = 13.0d0

      ads_data%state_mine = (/ 3, 5, 5 /)
      ads_data%rhs_du_state = 0
      allocate(ads_data%dUn0(2, 2, 2, 2, 2, 2, 3))
      allocate(ads_data%dUn13(2, 2, 2, 2, 2, 2, 3))
      allocate(ads_data%dUn23(2, 2, 2, 2, 2, 2, 3))
      ads_data%dUn0 = -1000.0d0
      ads_data%dUn13 = -2000.0d0
      ads_data%dUn23 = -3000.0d0
      ads_data%dUn0(2, 1, 2, 2, 1, 2, :) = (/ 101.0d0, 102.0d0, 103.0d0 /)
      ads_data%dUn13(2, 1, 2, 2, 1, 2, :) = (/ 201.0d0, 202.0d0, 203.0d0 /)
      ads_data%dUn23(2, 1, 2, 2, 1, 2, :) = (/ 301.0d0, 302.0d0, 303.0d0 /)
   end subroutine initialize_fixture


   logical function close_enough(actual, expected) result(close)
      real(kind=8), intent(in) :: actual, expected

      close = abs(actual - expected) <= 1.0d-12*max(1.0d0, abs(expected))
   end function close_enough


   function zero_forcing(un, du, X) result(value)
      real(kind=8), intent(in) :: un, du(3), X(3)
      real(kind=8) :: value

      value = 0.0d0*un + 0.0d0*sum(du) + 0.0d0*sum(X)
   end function zero_forcing


   function recording_forcing(un, du, X) result(value)
      real(kind=8), intent(in) :: un, du(3), X(3)
      real(kind=8) :: value

      forcing_calls = forcing_calls + 1
      last_forcing_un = un
      last_forcing_du = du
      last_forcing_X = X
      value = 0.5d0*un + 2.0d0*du(1) - 3.0d0*du(2) + 4.0d0*du(3) + &
              5.0d0*X(1) - 7.0d0*X(2) + 11.0d0*X(3)
   end function recording_forcing


   @test
   subroutine test_forcing_switches_from_initial_state_to_zero()
      real(kind=8) :: expected

      expected = initial_state(X_INPUT(1), X_INPUT(2), X_INPUT(3))

      problem_time = 0.0d0
      @assertTrue(close_enough(heat_forcing(41.0d0, DU_INPUT, X_INPUT), expected))
      problem_time = -0.5d0
      @assertTrue(close_enough(heat_forcing(-7.0d0, -DU_INPUT, X_INPUT), expected))
      problem_time = 0.5d0
      @assertTrue(heat_forcing(41.0d0, DU_INPUT, X_INPUT) == 0.0d0)
   end subroutine test_forcing_switches_from_initial_state_to_zero


   @test
   subroutine test_initial_step_is_weighted_mass_projection()
      type(ADS_Setup) :: ads
      type(ADS_compute_data) :: ads_data
      real(kind=8) :: alpha_step(7, 3), expected, ret, source

      call initialize_fixture(ads, ads_data)
      problem_time = 0.0d0
      alpha_step = 999.0d0
      ads_data%rhs_du_state = -999
      source = initial_state(X_INPUT(1), X_INPUT(2), X_INPUT(3))

      call heat_igrm_rhs_point(ads, X_INPUT, K_INDEX, E_INDEX, A_INDEX, DU_INPUT, 123, &
                               STAGE_VALUES(1), STAGE_VALUES(2), STAGE_VALUES(3), &
                               ads_data, 1.5d0, 0.4d0, DIRECTION, 0, alpha_step, &
                               heat_forcing, ret)

      expected = 1.5d0*0.4d0*TEST_VALUE*source
      @assertTrue(close_enough(ret, expected))
   end subroutine test_initial_step_is_weighted_mass_projection


   @test
   subroutine test_mass_term_selects_each_substep_state()
      type(ADS_Setup) :: ads
      type(ADS_compute_data) :: ads_data
      integer(kind=4) :: substep
      real(kind=8) :: alpha_step(7, 3), expected, ret

      call initialize_fixture(ads, ads_data)
      problem_time = 1.0d0
      alpha_step = 0.0d0

      do substep = 1, 3
         call heat_igrm_rhs_point(ads, X_INPUT, K_INDEX, E_INDEX, A_INDEX, DU_INPUT, 321, &
                                  STAGE_VALUES(1), STAGE_VALUES(2), STAGE_VALUES(3), &
                                  ads_data, 1.5d0, 0.4d0, DIRECTION, substep, alpha_step, &
                                  zero_forcing, ret)
         expected = 1.5d0*0.4d0*STAGE_VALUES(substep)*TEST_VALUE
         @assertTrue(close_enough(ret, expected))
      end do
   end subroutine test_mass_term_selects_each_substep_state


   @test
   subroutine test_all_derivative_state_selectors()
      type(ADS_Setup) :: ads
      type(ADS_compute_data) :: ads_data
      integer(kind=4) :: selector
      real(kind=8) :: alpha_step(7, 3), derivatives(3), diffusion, expected, ret

      call initialize_fixture(ads, ads_data)
      problem_time = 1.0d0

      do selector = 0, 3
         alpha_step = 0.0d0
         alpha_step(1, 2) = 0.5d0
         alpha_step(3, 2) = -1.25d0
         alpha_step(5, 2) = 2.0d0
         ads_data%rhs_du_state(:, 2) = selector

         select case (selector)
         case (0)
            derivatives = DU_INPUT
         case (1)
            derivatives = (/ 101.0d0, 102.0d0, 103.0d0 /)
         case (2)
            derivatives = (/ 201.0d0, 202.0d0, 203.0d0 /)
         case (3)
            derivatives = (/ 301.0d0, 302.0d0, 303.0d0 /)
         end select

         diffusion = 0.5d0*derivatives(1)*TEST_DERIVATIVES(1) - &
                     1.25d0*derivatives(2)*TEST_DERIVATIVES(2) + &
                     2.0d0*derivatives(3)*TEST_DERIVATIVES(3)
         expected = 1.5d0*0.4d0*(STAGE_VALUES(2)*TEST_VALUE + ads%tau*diffusion)

         call heat_igrm_rhs_point(ads, X_INPUT, K_INDEX, E_INDEX, A_INDEX, DU_INPUT, 654, &
                                  STAGE_VALUES(1), STAGE_VALUES(2), STAGE_VALUES(3), &
                                  ads_data, 1.5d0, 0.4d0, DIRECTION, 2, alpha_step, &
                                  zero_forcing, ret)
         @assertTrue(close_enough(ret, expected))
      end do
   end subroutine test_all_derivative_state_selectors


   @test
   subroutine test_forcing_receives_selected_substep_state()
      type(ADS_Setup) :: ads
      type(ADS_compute_data) :: ads_data
      integer(kind=4) :: substep
      real(kind=8) :: alpha_step(7, 3), expected, ret, source

      call initialize_fixture(ads, ads_data)
      problem_time = 1.0d0

      do substep = 1, 3
         forcing_calls = 0
         last_forcing_un = 0.0d0
         alpha_step = 0.0d0
         alpha_step(7, substep) = 2.5d0
         ads_data%rhs_du_state(:, substep) = 0

         call heat_igrm_rhs_point(ads, X_INPUT, K_INDEX, E_INDEX, A_INDEX, DU_INPUT, 789, &
                                  STAGE_VALUES(1), STAGE_VALUES(2), STAGE_VALUES(3), &
                                  ads_data, 2.0d0, 3.0d0, DIRECTION, substep, alpha_step, &
                                  recording_forcing, ret)

         source = 0.5d0*STAGE_VALUES(substep) + 2.0d0*DU_INPUT(1) - &
                  3.0d0*DU_INPUT(2) + 4.0d0*DU_INPUT(3) + &
                  5.0d0*X_INPUT(1) - 7.0d0*X_INPUT(2) + 11.0d0*X_INPUT(3)
         expected = 6.0d0*(STAGE_VALUES(substep)*TEST_VALUE + &
                    ads%tau*2.5d0*source*TEST_VALUE)

         @assertTrue(close_enough(ret, expected))
         @assertEqual(1, forcing_calls)
         @assertTrue(close_enough(last_forcing_un, STAGE_VALUES(substep)))
         @assertTrue(all(last_forcing_du == DU_INPUT))
         @assertTrue(all(last_forcing_X == X_INPUT))
      end do
   end subroutine test_forcing_receives_selected_substep_state


   @test
   subroutine test_transport_rows_are_ignored()
      type(ADS_Setup) :: ads
      type(ADS_compute_data) :: ads_data
      real(kind=8) :: alpha_step(7, 3), expected, ret

      call initialize_fixture(ads, ads_data)
      problem_time = 1.0d0
      alpha_step = 0.0d0
      alpha_step(2, 3) = 1.0d6
      alpha_step(4, 3) = -2.0d6
      alpha_step(6, 3) = 3.0d6
      ads_data%rhs_du_state(:, 3) = (/ 0, 1, 2, 3, 1, 2 /)

      call heat_igrm_rhs_point(ads, X_INPUT, K_INDEX, E_INDEX, A_INDEX, DU_INPUT, 987, &
                               STAGE_VALUES(1), STAGE_VALUES(2), STAGE_VALUES(3), &
                               ads_data, 1.5d0, 0.4d0, DIRECTION, 3, alpha_step, &
                               zero_forcing, ret)

      expected = 1.5d0*0.4d0*STAGE_VALUES(3)*TEST_VALUE
      @assertTrue(close_enough(ret, expected))
   end subroutine test_transport_rows_are_ignored


   integer(kind=4) function invalid_case_exit(mode) result(exit_code)
      use iso_c_binding, only: c_char, c_int, c_null_char
      type(ADS_Setup) :: ads
      type(ADS_compute_data) :: ads_data
      integer(kind=4), intent(in) :: mode
      integer(kind=4) :: substep
      integer(c_int) :: child, child_status, ignored, null_fd, waited
      real(kind=8) :: alpha_step(7, 3), ret
      character(kind=c_char), parameter :: null_path(10) = &
         (/ '/', 'd', 'e', 'v', '/', 'n', 'u', 'l', 'l', c_null_char /)

      interface
         function c_fork() bind(C, name='fork') result(pid)
            import :: c_int
            integer(c_int) :: pid
         end function c_fork

         function c_waitpid(pid, status, options) bind(C, name='waitpid') result(waited_pid)
            import :: c_int
            integer(c_int), value :: pid
            integer(c_int), intent(out) :: status
            integer(c_int), value :: options
            integer(c_int) :: waited_pid
         end function c_waitpid

         function c_open(path, flags) bind(C, name='open') result(fd)
            import :: c_char, c_int
            character(kind=c_char), intent(in) :: path(*)
            integer(c_int), value :: flags
            integer(c_int) :: fd
         end function c_open

         function c_dup2(oldfd, newfd) bind(C, name='dup2') result(fd)
            import :: c_int
            integer(c_int), value :: oldfd, newfd
            integer(c_int) :: fd
         end function c_dup2

         function c_close(fd) bind(C, name='close') result(status)
            import :: c_int
            integer(c_int), value :: fd
            integer(c_int) :: status
         end function c_close
      end interface

      call initialize_fixture(ads, ads_data)
      problem_time = 1.0d0
      alpha_step = 0.0d0
      substep = 1

      select case (mode)
      case (1)
         substep = 0
      case (2)
         substep = 4
      case (3)
         ads_data%rhs_du_state(1, 1) = -1
      case (4)
         ads_data%rhs_du_state(6, 1) = 4
      end select

      child = c_fork()
      if (child < 0_c_int) then
         exit_code = -1
         return
      else if (child == 0_c_int) then
         null_fd = c_open(null_path, 1_c_int)
         if (null_fd >= 0_c_int) then
            ignored = c_dup2(null_fd, 2_c_int)
            if (null_fd /= 2_c_int) ignored = c_close(null_fd)
         end if
         call heat_igrm_rhs_point(ads, X_INPUT, K_INDEX, E_INDEX, A_INDEX, DU_INPUT, 0, &
                                  STAGE_VALUES(1), STAGE_VALUES(2), STAGE_VALUES(3), &
                                  ads_data, 1.0d0, 1.0d0, DIRECTION, substep, alpha_step, &
                                  zero_forcing, ret)
         stop 99
      end if

      waited = c_waitpid(child, child_status, 0_c_int)
      if (waited /= child) then
         exit_code = -1
      else if (iand(child_status, 127_c_int) /= 0_c_int) then
         exit_code = 128 + iand(child_status, 127_c_int)
      else
         exit_code = iand(shiftr(child_status, 8), 255_c_int)
      end if
   end function invalid_case_exit


   @test
   subroutine test_invalid_substeps_and_states_terminate()
      integer(kind=4) :: exit_code, mode

      do mode = 1, 4
         exit_code = invalid_case_exit(mode)
         @assertEqual(1, exit_code)
      end do
   end subroutine test_invalid_substeps_and_states_terminate

end module test_igrm_heat_rhs_fun
