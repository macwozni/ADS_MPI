module test_gauss
   use pfunit
   use gauss, only: GaussRule
   implicit none

   real(kind=8), parameter :: property_tol = 1.0d-13

contains

   @test
   subroutine test_public_maximum_matches_available_rules()
      use gauss, only: MAX_GAUSS_POINTS

      @assertEqual(10, MAX_GAUSS_POINTS)
   end subroutine test_public_maximum_matches_available_rules


   subroutine assert_vec_near(a, b, tol)
      real(kind=8), intent(in) :: a(:), b(:)
      real(kind=8), intent(in) :: tol

      @assertEqual(size(a), size(b))
      @assertTrue(all(abs(a - b) <= tol))
   end subroutine assert_vec_near


   pure real(kind=8) function exact_monomial_integral(degree) result(value)
      integer(kind=4), intent(in) :: degree

      if (mod(degree, 2) == 0) then
         value = 2.0d0/real(degree + 1, kind=8)
      else
         value = 0.0d0
      end if
   end function exact_monomial_integral


   @test
   subroutine test_concurrent_first_use_returns_complete_rules()
      use omp_lib, only: omp_get_num_threads
      real(kind=8) :: X(0:9), W(0:9)
      integer(kind=4) :: failures, threads_seen

      failures = 0
      threads_seen = 0

!$omp parallel default(none) private(X,W) shared(threads_seen) &
!$omp reduction(+:failures)
!$omp single
      threads_seen = omp_get_num_threads()
!$omp end single
      call GaussRule(10, X, W)

      if (.not. (all(X > -1.0d0) .and. all(X < 1.0d0) .and. &
                 all(W > 0.0d0) .and. &
                 abs(sum(W) - 2.0d0) <= property_tol .and. &
                 all(abs(X + X(9:0:-1)) <= property_tol) .and. &
                 all(abs(W - W(9:0:-1)) <= property_tol))) then
         failures = failures + 1
      end if
!$omp end parallel

      @assertEqual(8, threads_seen)
      @assertEqual(0, failures)
   end subroutine test_concurrent_first_use_returns_complete_rules


   @test
   subroutine test_zero_point_rule_returns_empty_arrays()
      use gauss, only: GaussRule
      real(kind=8), allocatable :: X(:), W(:)

      allocate(X(0:-1), W(0:-1))
      call GaussRule(0, X, W)

      @assertEqual(0, size(X))
      @assertEqual(0, size(W))
      deallocate(X, W)
   end subroutine test_zero_point_rule_returns_empty_arrays


   @test
   subroutine test_gauss_rule_1()
      real(kind=8) :: X(0:0), W(0:0)
      real(kind=8) :: Xref(0:0), Wref(0:0)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(1, X, W)

      Xref = (/ &
         0.0000000000000000d0 &
      /)

      Wref = (/ &
         2.0000000000000000d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_1


   @test
   subroutine test_gauss_rule_2()
      real(kind=8) :: X(0:1), W(0:1)
      real(kind=8) :: Xref(0:1), Wref(0:1)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(2, X, W)

      Xref = (/ &
        -0.57735026918962576451d0, &
         0.57735026918962576451d0 &
      /)

      Wref = (/ &
         1.00000000000000000000d0, &
         1.00000000000000000000d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_2


   @test
   subroutine test_gauss_rule_3()
      real(kind=8) :: X(0:2), W(0:2)
      real(kind=8) :: Xref(0:2), Wref(0:2)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(3, X, W)

      Xref = (/ &
        -0.77459666924148337704d0, &
         0.00000000000000000000d0, &
         0.77459666924148337704d0 &
      /)

      Wref = (/ &
         0.55555555555555555556d0, &
         0.88888888888888888889d0, &
         0.55555555555555555556d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_3


   @test
   subroutine test_gauss_rule_4()
      real(kind=8) :: X(0:3), W(0:3)
      real(kind=8) :: Xref(0:3), Wref(0:3)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(4, X, W)

      Xref = (/ &
        -0.86113631159405257522d0, &
        -0.33998104358485626480d0, &
         0.33998104358485626480d0, &
         0.86113631159405257522d0 &
      /)

      Wref = (/ &
         0.34785484513745385737d0, &
         0.65214515486254614263d0, &
         0.65214515486254614263d0, &
         0.34785484513745385737d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_4


   @test
   subroutine test_gauss_rule_5()
      real(kind=8) :: X(0:4), W(0:4)
      real(kind=8) :: Xref(0:4), Wref(0:4)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(5, X, W)

      Xref = (/ &
        -0.90617984593866399280d0, &
        -0.53846931010568309104d0, &
         0.00000000000000000000d0, &
         0.53846931010568309104d0, &
         0.90617984593866399280d0 &
      /)

      Wref = (/ &
         0.23692688505618908751d0, &
         0.47862867049936646804d0, &
         0.56888888888888888889d0, &
         0.47862867049936646804d0, &
         0.23692688505618908751d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_5


   @test
   subroutine test_gauss_rule_6()
      real(kind=8) :: X(0:5), W(0:5)
      real(kind=8) :: Xref(0:5), Wref(0:5)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(6, X, W)

      Xref = (/ &
        -0.93246951420315202781d0, &
        -0.66120938646626451366d0, &
        -0.23861918608319690863d0, &
         0.23861918608319690863d0, &
         0.66120938646626451366d0, &
         0.93246951420315202781d0 &
      /)

      Wref = (/ &
         0.17132449237917034504d0, &
         0.36076157304813860757d0, &
         0.46791393457269104739d0, &
         0.46791393457269104739d0, &
         0.36076157304813860757d0, &
         0.17132449237917034504d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_6


   @test
   subroutine test_gauss_rule_7()
      real(kind=8) :: X(0:6), W(0:6)
      real(kind=8) :: Xref(0:6), Wref(0:6)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(7, X, W)

      Xref = (/ &
        -0.94910791234275852453d0, &
        -0.74153118559939443986d0, &
        -0.40584515137739716691d0, &
         0.00000000000000000000d0, &
         0.40584515137739716691d0, &
         0.74153118559939443986d0, &
         0.94910791234275852453d0 &
      /)

      Wref = (/ &
         0.12948496616886969327d0, &
         0.27970539148927666790d0, &
         0.38183005050511894495d0, &
         0.41795918367346938776d0, &
         0.38183005050511894495d0, &
         0.27970539148927666790d0, &
         0.12948496616886969327d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_7


   @test
   subroutine test_gauss_rule_8()
      real(kind=8) :: X(0:7), W(0:7)
      real(kind=8) :: Xref(0:7), Wref(0:7)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(8, X, W)

      Xref = (/ &
        -0.96028985649753623168d0, &
        -0.79666647741362673959d0, &
        -0.52553240991632898582d0, &
        -0.18343464249564980494d0, &
         0.18343464249564980494d0, &
         0.52553240991632898582d0, &
         0.79666647741362673959d0, &
         0.96028985649753623168d0 &
      /)

      Wref = (/ &
         0.10122853629037625915d0, &
         0.22238103445337447054d0, &
         0.31370664587788728734d0, &
         0.36268378337836198297d0, &
         0.36268378337836198297d0, &
         0.31370664587788728734d0, &
         0.22238103445337447054d0, &
         0.10122853629037625915d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_8


   @test
   subroutine test_gauss_rule_9()
      real(kind=8) :: X(0:8), W(0:8)
      real(kind=8) :: Xref(0:8), Wref(0:8)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(9, X, W)

      Xref = (/ &
        -0.96816023950762608984d0, &
        -0.83603110732663579430d0, &
        -0.61337143270059039731d0, &
        -0.32425342340380892904d0, &
         0.00000000000000000000d0, &
         0.32425342340380892904d0, &
         0.61337143270059039731d0, &
         0.83603110732663579430d0, &
         0.96816023950762608984d0 &
      /)

      Wref = (/ &
         0.08127438836157441197d0, &
         0.18064816069485740406d0, &
         0.26061069640293546232d0, &
         0.31234707704000284007d0, &
         0.33023935500125976316d0, &
         0.31234707704000284007d0, &
         0.26061069640293546232d0, &
         0.18064816069485740406d0, &
         0.08127438836157441197d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_9


   @test
   subroutine test_gauss_rule_10()
      real(kind=8) :: X(0:9), W(0:9)
      real(kind=8) :: Xref(0:9), Wref(0:9)
      real(kind=8), parameter :: tol = 1.0d-14

      call GaussRule(10, X, W)

      Xref = (/ &
        -0.97390652851717172008d0, &
        -0.86506336668898451073d0, &
        -0.67940956829902440623d0, &
        -0.43339539412924719080d0, &
        -0.14887433898163121088d0, &
         0.14887433898163121088d0, &
         0.43339539412924719080d0, &
         0.67940956829902440623d0, &
         0.86506336668898451073d0, &
         0.97390652851717172008d0 &
      /)

      Wref = (/ &
         0.06667134430868813759d0, &
         0.14945134915058059315d0, &
         0.21908636251598204399d0, &
         0.26926671930999635509d0, &
         0.29552422471475287017d0, &
         0.29552422471475287017d0, &
         0.26926671930999635509d0, &
         0.21908636251598204399d0, &
         0.14945134915058059315d0, &
         0.06667134430868813759d0 &
      /)

      call assert_vec_near(X, Xref, tol)
      call assert_vec_near(W, Wref, tol)
   end subroutine test_gauss_rule_10


   @test
   subroutine test_all_rules_have_valid_symmetric_nodes_and_weights()
      real(kind=8), allocatable :: X(:), W(:)
      integer(kind=4) :: i, n

      do n = 1, 10
         allocate(X(0:n - 1), W(0:n - 1))
         call GaussRule(n, X, W)

         @assertTrue(all(X > -1.0d0))
         @assertTrue(all(X < 1.0d0))
         @assertTrue(all(W > 0.0d0))
         @assertTrue(abs(sum(W) - 2.0d0) <= property_tol)

         if (n > 1) then
            @assertTrue(all(X(1:n - 1) > X(0:n - 2)))
         end if
         do i = 0, n - 1
            @assertTrue(abs(X(i) + X(n - 1 - i)) <= property_tol)
            @assertTrue(abs(W(i) - W(n - 1 - i)) <= property_tol)
         end do

         deallocate(X, W)
      end do
   end subroutine test_all_rules_have_valid_symmetric_nodes_and_weights


   @test
   subroutine test_all_rules_integrate_monomials_through_degree_2n_minus_1()
      real(kind=8), allocatable :: X(:), W(:)
      real(kind=8) :: actual, expected
      integer(kind=4) :: degree, n

      do n = 1, 10
         allocate(X(0:n - 1), W(0:n - 1))
         call GaussRule(n, X, W)

         do degree = 0, 2*n - 1
            actual = sum(W*X**degree)
            expected = exact_monomial_integral(degree)
            @assertTrue(abs(actual - expected) <= property_tol)
         end do

         deallocate(X, W)
      end do
   end subroutine test_all_rules_integrate_monomials_through_degree_2n_minus_1


   @test
   subroutine test_unsupported_rule_returns_zero_arrays()
      real(kind=8) :: X(0:10), W(0:10)

      X = 17.0d0
      W = -23.0d0
      call GaussRule(11, X, W)

      @assertTrue(all(X == 0.0d0))
      @assertTrue(all(W == 0.0d0))
   end subroutine test_unsupported_rule_returns_zero_arrays


   @test
   subroutine test_repeated_and_interleaved_calls_are_stable()
      real(kind=8) :: X1(0:0), W1(0:0)
      real(kind=8) :: X6(0:5), W6(0:5)
      real(kind=8) :: X10_first(0:9), W10_first(0:9)
      real(kind=8) :: X10_second(0:9), W10_second(0:9)

      call GaussRule(10, X10_first, W10_first)
      call GaussRule(1, X1, W1)
      call GaussRule(6, X6, W6)
      call GaussRule(10, X10_second, W10_second)

      call assert_vec_near(X10_second, X10_first, 0.0d0)
      call assert_vec_near(W10_second, W10_first, 0.0d0)
      @assertTrue(X1(0) == 0.0d0)
      @assertTrue(W1(0) == 2.0d0)
      @assertTrue(all(W6 > 0.0d0))
   end subroutine test_repeated_and_interleaved_calls_are_stable

end module test_gauss
