module test_operator_assembly
   use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
   use pfunit
   use knot_vector, only: PrepareKnot
   use omp_lib, only: omp_set_dynamic, omp_set_num_threads
   use operator_assembly, only: MKBBT_large, MKBBT_small, ComputeMatrix
   use sparse, only: sparse_matrix, clear_matrix, to_dense_matrix
   implicit none

   real(kind=8), parameter :: TOL = 4096.d0*epsilon(1.d0)
   real(kind=8), parameter :: U_LINEAR(0:3) = (/0.d0, 0.d0, 1.d0, 1.d0/)
   real(kind=8), parameter :: U_QUADRATIC(0:5) = &
      (/0.d0, 0.d0, 0.d0, 1.d0, 1.d0, 1.d0/)

contains

   logical function matrices_near(actual, expected) result(matches)
      real(kind=8), intent(in) :: actual(:, :), expected(:, :)

      matches = all(shape(actual) == shape(expected))
      if (.not. matches) return
      matches = maxval(abs(actual - expected)) <= &
                TOL*max(1.d0, maxval(abs(expected)))
   end function matrices_near


   subroutine assemble_small(U, p, n, nelem, mix, dense, entry_count)
      integer(kind=4), intent(in) :: p, n, nelem
      real(kind=8), intent(in) :: U(0:n + p + 1), mix(4)
      real(kind=8), allocatable, intent(out) :: dense(:, :)
      integer(kind=8), intent(out) :: entry_count
      type(sparse_matrix), pointer :: matrix

      nullify(matrix)
      call MKBBT_small(nelem, U, p, n, mix, matrix)
      allocate(dense(matrix%x, matrix%y))
      call to_dense_matrix(matrix, dense)
      entry_count = matrix%total_entries
      call clear_matrix(matrix)
   end subroutine assemble_small


   subroutine assemble_large(U1, p1, n1, U2, p2, n2, nelem, &
                             mixA, mixB, mixBT, dense, entry_count)
      integer(kind=4), intent(in) :: p1, n1, p2, n2, nelem
      real(kind=8), intent(in) :: U1(0:n1 + p1 + 1)
      real(kind=8), intent(in) :: U2(0:n2 + p2 + 1)
      real(kind=8), intent(in) :: mixA(4), mixB(4), mixBT(4)
      real(kind=8), allocatable, intent(out) :: dense(:, :)
      integer(kind=8), intent(out) :: entry_count
      type(sparse_matrix), pointer :: matrix

      nullify(matrix)
      call MKBBT_large(nelem, U1, p1, n1, U2, p2, n2, &
                       mixA, mixB, mixBT, matrix)
      allocate(dense(matrix%x, matrix%y))
      call to_dense_matrix(matrix, dense)
      entry_count = matrix%total_entries
      call clear_matrix(matrix)
   end subroutine assemble_large


   subroutine compute_dense(U1, p1, n1, nelem1, U2, p2, n2, nelem2, &
                            mixA, mixB, mixBT, equal_space, dense, entry_count)
      integer(kind=4), intent(in) :: p1, n1, nelem1, p2, n2, nelem2
      real(kind=8), intent(in) :: U1(0:n1 + p1 + 1)
      real(kind=8), intent(in) :: U2(0:n2 + p2 + 1)
      real(kind=8), intent(in) :: mixA(4), mixB(4), mixBT(4)
      logical, intent(in) :: equal_space
      real(kind=8), allocatable, intent(out) :: dense(:, :)
      integer(kind=8), intent(out) :: entry_count
      type(sparse_matrix), pointer :: matrix

      nullify(matrix)
      call ComputeMatrix(U1, p1, n1, nelem1, U2, p2, n2, nelem2, &
                         mixA, mixB, mixBT, equal_space, matrix)
      allocate(dense(matrix%x, matrix%y))
      call to_dense_matrix(matrix, dense)
      entry_count = matrix%total_entries
      call clear_matrix(matrix)
   end subroutine compute_dense


   subroutine make_open_knots(nelem, p, n, U)
      integer(kind=4), intent(in) :: nelem, p
      integer(kind=4), intent(out) :: n
      real(kind=8), allocatable, intent(out) :: U(:)
      integer(kind=4) :: actual_nelem

      n = nelem + p - 1
      call PrepareKnot(n, p, U, actual_nelem)
      if (actual_nelem /= nelem) stop 91
   end subroutine make_open_knots


   subroutine linear_term_matrix(term, expected)
      integer(kind=4), intent(in) :: term
      real(kind=8), intent(out) :: expected(2, 2)

      select case (term)
      case (1)
         expected(1, :) = (/1.d0/3.d0, 1.d0/6.d0/)
         expected(2, :) = (/1.d0/6.d0, 1.d0/3.d0/)
      case (2)
         expected(1, :) = (/1.d0, -1.d0/)
         expected(2, :) = (/-1.d0, 1.d0/)
      case (3)
         expected(1, :) = (/-0.5d0, -0.5d0/)
         expected(2, :) = (/0.5d0, 0.5d0/)
      case (4)
         expected(1, :) = (/-0.5d0, 0.5d0/)
         expected(2, :) = (/-0.5d0, 0.5d0/)
      end select
   end subroutine linear_term_matrix


   subroutine exact_small_combination(expected)
      real(kind=8), intent(out) :: expected(2, 2)

      expected(1, :) = (/-7.d0/6.d0, -4.d0/3.d0/)
      expected(2, :) = (/-7.d0/3.d0, 35.d0/6.d0/)
   end subroutine exact_small_combination


   subroutine exact_large_combination(expected)
      real(kind=8), intent(out) :: expected(5, 5)

      expected = 0.d0
      expected(1, :) = &
         (/-7.d0/6.d0, -4.d0/3.d0, -5.d0/12.d0, 7.d0/6.d0, -21.d0/4.d0/)
      expected(2, :) = &
         (/-7.d0/3.d0, 35.d0/6.d0, -71.d0/12.d0, 0.5d0, 179.d0/12.d0/)
      expected(3, 1:2) = (/11.d0/12.d0, -107.d0/12.d0/)
      expected(4, 1:2) = (/7.d0/6.d0, 11.d0/6.d0/)
      expected(5, 1:2) = (/-115.d0/12.d0, 283.d0/12.d0/)
   end subroutine exact_large_combination


   subroutine uniform_linear_expected(nelem, mix, expected)
      integer(kind=4), intent(in) :: nelem
      real(kind=8), intent(in) :: mix(4)
      real(kind=8), intent(out) :: expected(nelem + 1, nelem + 1)
      integer(kind=4) :: i
      real(kind=8) :: bdiag, h, kdiag, mdiag

      h = 1.d0/real(nelem, kind=8)
      expected = 0.d0

      do i = 1, nelem + 1
         if (i == 1 .or. i == nelem + 1) then
            mdiag = h/3.d0
            kdiag = 1.d0/h
         else
            mdiag = 2.d0*h/3.d0
            kdiag = 2.d0/h
         end if
         bdiag = 0.d0
         if (i == 1) bdiag = -0.5d0
         if (i == nelem + 1) bdiag = 0.5d0
         expected(i, i) = mix(1)*mdiag + mix(2)*kdiag + &
                          (mix(3) + mix(4))*bdiag
      end do

      do i = 1, nelem
         expected(i, i + 1) = mix(1)*h/6.d0 - mix(2)/h - &
                              0.5d0*mix(3) + 0.5d0*mix(4)
         expected(i + 1, i) = mix(1)*h/6.d0 - mix(2)/h + &
                              0.5d0*mix(3) - 0.5d0*mix(4)
      end do
   end subroutine uniform_linear_expected


   @test
   subroutine test_small_has_exact_elementary_forms()
      integer(kind=4) :: term
      integer(kind=8) :: entries
      real(kind=8) :: expected(2, 2), mix(4)
      real(kind=8), allocatable :: actual(:, :)

      mix = 0.d0
      call assemble_small(U_LINEAR, 1, 1, 1, mix, actual, entries)
      @assertTrue(entries == 4_8)
      @assertTrue(maxval(abs(actual)) == 0.d0)

      do term = 1, 4
         mix = 0.d0
         mix(term) = 1.d0
         call assemble_small(U_LINEAR, 1, 1, 1, mix, actual, entries)
         call linear_term_matrix(term, expected)
         @assertTrue(entries == 4_8)
         @assertTrue(matrices_near(actual, expected))
      end do
   end subroutine test_small_has_exact_elementary_forms


   @test
   subroutine test_small_combines_all_terms()
      integer(kind=8) :: entries
      real(kind=8) :: expected(2, 2)
      real(kind=8), allocatable :: actual(:, :)

      call exact_small_combination(expected)
      call assemble_small(U_LINEAR, 1, 1, 1, (/1.d0, 2.d0, 3.d0, 4.d0/), &
                          actual, entries)

      @assertTrue(entries == 4_8)
      @assertTrue(matrices_near(actual, expected))
   end subroutine test_small_combines_all_terms


   @test
   subroutine test_small_scales_on_affine_interval()
      real(kind=8), parameter :: U_SCALED(0:3) = (/2.d0, 2.d0, 5.d0, 5.d0/)
      integer(kind=4) :: term
      integer(kind=8) :: entries
      real(kind=8) :: expected(2, 2), mix(4)
      real(kind=8), allocatable :: actual(:, :)

      do term = 1, 4
         mix = 0.d0
         mix(term) = 1.d0
         call assemble_small(U_SCALED, 1, 1, 1, mix, actual, entries)
         call linear_term_matrix(term, expected)
         if (term == 1) expected = 3.d0*expected
         if (term == 2) expected = expected/3.d0
         @assertTrue(matrices_near(actual, expected))
      end do
   end subroutine test_small_scales_on_affine_interval


   @test
   subroutine test_small_supports_degree_zero()
      real(kind=8), parameter :: U_CONSTANT(0:3) = (/0.d0, 0.2d0, 0.7d0, 1.d0/)
      integer(kind=8) :: entries
      real(kind=8) :: expected(3, 3)
      real(kind=8), allocatable :: actual(:, :)

      expected = 0.d0
      expected(1, 1) = 0.4d0
      expected(2, 2) = 1.d0
      expected(3, 3) = 0.6d0
      call assemble_small(U_CONSTANT, 0, 2, 3, &
                          (/2.d0, 5.d0, -7.d0, 11.d0/), actual, entries)

      @assertTrue(entries == 3_8)
      @assertTrue(matrices_near(actual, expected))
   end subroutine test_small_supports_degree_zero


   @test
   subroutine test_small_supports_maximum_degree_nine()
      integer(kind=4), parameter :: nelem = 1
      real(kind=8), parameter :: MASS(4) = (/1.d0, 0.d0, 0.d0, 0.d0/)
      integer(kind=4) :: n
      integer(kind=8) :: entries
      real(kind=8), allocatable :: actual(:, :), U(:)

      call make_open_knots(nelem, 9, n, U)
      call assemble_small(U, 9, n, nelem, MASS, actual, entries)

      @assertTrue(n == 9)
      @assertTrue(all(shape(actual) == (/10, 10/)))
      @assertTrue(entries == 100_8)
      @assertTrue(all(ieee_is_finite(actual)))
      @assertTrue(maxval(abs(actual - transpose(actual))) <= TOL)
      @assertTrue(abs(sum(actual) - 1.d0) <= TOL)
      @assertTrue(maxval(abs(sum(actual, dim=2) - 0.1d0)) <= TOL)
   end subroutine test_small_supports_maximum_degree_nine


   @test
   subroutine test_small_is_deterministic_with_openmp()
      integer(kind=4), parameter :: nelem = 8
      integer(kind=4) :: n
      integer(kind=8) :: entries1, entries4
      real(kind=8), parameter :: mix(4) = (/1.25d0, -0.75d0, 0.5d0, -1.5d0/)
      real(kind=8), allocatable :: actual1(:, :), actual4(:, :), expected(:, :), U(:)

      call make_open_knots(nelem, 1, n, U)
      allocate(expected(nelem + 1, nelem + 1))
      call uniform_linear_expected(nelem, mix, expected)
      call omp_set_dynamic(.false.)
      call omp_set_num_threads(1)
      call assemble_small(U, 1, n, nelem, mix, actual1, entries1)
      call omp_set_num_threads(4)
      call assemble_small(U, 1, n, nelem, mix, actual4, entries4)
      call omp_set_num_threads(1)

      @assertTrue(entries1 == 25_8)
      @assertTrue(entries4 == entries1)
      @assertTrue(matrices_near(actual1, expected))
      @assertTrue(matrices_near(actual4, expected))
      @assertTrue(all(actual1 == actual4))
   end subroutine test_small_is_deterministic_with_openmp


   @test
   subroutine test_large_has_exact_enriched_blocks()
      integer(kind=8) :: entries
      real(kind=8) :: expected(5, 5)
      real(kind=8), allocatable :: actual(:, :)

      call exact_large_combination(expected)
      call assemble_large(U_QUADRATIC, 2, 2, U_LINEAR, 1, 1, 1, &
                          (/1.d0, 2.d0, 3.d0, 4.d0/), &
                          (/5.d0, 6.d0, 7.d0, 8.d0/), &
                          (/9.d0, 10.d0, 11.d0, 12.d0/), actual, entries)

      @assertTrue(entries == 16_8)
      @assertTrue(matrices_near(actual, expected))
   end subroutine test_large_has_exact_enriched_blocks


   @test
   subroutine test_large_and_dispatch_support_degree_zero_trial()
      real(kind=8), parameter :: U_CONSTANT(0:1) = (/0.d0, 1.d0/)
      integer(kind=8) :: direct_entries, dispatch_entries
      real(kind=8) :: expected(3, 3)
      real(kind=8), allocatable :: direct(:, :), dispatch(:, :)

      expected = 0.d0
      expected(1, :) = (/1.d0, -1.d0, 1.d0/)
      expected(2:3, 1) = (/-1.d0, 1.d0/)

      call assemble_large(U_LINEAR, 1, 1, U_CONSTANT, 0, 0, 1, &
                          (/1.d0, 0.d0, 0.d0, 0.d0/), &
                          (/0.d0, 0.d0, 0.d0, 1.d0/), &
                          (/0.d0, 0.d0, 1.d0, 0.d0/), &
                          direct, direct_entries)
      call compute_dense(U_LINEAR, 1, 1, 1, U_CONSTANT, 0, 0, 1, &
                         (/1.d0, 0.d0, 0.d0, 0.d0/), &
                         (/0.d0, 0.d0, 0.d0, 1.d0/), &
                         (/0.d0, 0.d0, 1.d0, 0.d0/), .false., &
                         dispatch, dispatch_entries)

      @assertTrue(direct_entries == 5_8)
      @assertTrue(dispatch_entries == direct_entries)
      @assertTrue(matrices_near(direct, expected))
      @assertTrue(matrices_near(dispatch, expected))
   end subroutine test_large_and_dispatch_support_degree_zero_trial


   @test
   subroutine test_large_handles_mixed_knot_multiplicity()
      real(kind=8), parameter :: U_TEST(0:7) = &
         (/0.d0, 0.d0, 0.d0, 0.5d0, 0.5d0, 1.d0, 1.d0, 1.d0/)
      real(kind=8), parameter :: U_TRIAL(0:4) = &
         (/0.d0, 0.d0, 0.5d0, 1.d0, 1.d0/)
      real(kind=8), parameter :: MASS(4) = (/1.d0, 0.d0, 0.d0, 0.d0/)
      real(kind=8), parameter :: EXPECTED_ROW_SUMS(8) = &
         (/0.5d0, 1.d0, 0.5d0, 1.d0/6.d0, 1.d0/6.d0, &
           1.d0/3.d0, 1.d0/6.d0, 1.d0/6.d0/)
      integer(kind=8) :: entries
      real(kind=8), allocatable :: actual(:, :)

      call assemble_large(U_TEST, 2, 4, U_TRIAL, 1, 2, 2, &
                          MASS, MASS, MASS, actual, entries)

      @assertTrue(all(shape(actual) == (/8, 8/)))
      @assertTrue(entries == 29_8)
      @assertTrue(maxval(abs(actual - transpose(actual))) <= TOL)
      @assertTrue(maxval(abs(actual(4:8, 4:8))) == 0.d0)
      @assertTrue(abs(sum(actual(1:3, 1:3)) - 1.d0) <= TOL)
      @assertTrue(abs(sum(actual(1:3, 4:8)) - 1.d0) <= TOL)
      @assertTrue(abs(sum(actual(4:8, 1:3)) - 1.d0) <= TOL)
      @assertTrue(maxval(abs(sum(actual, dim=2) - EXPECTED_ROW_SUMS)) <= TOL)
   end subroutine test_large_handles_mixed_knot_multiplicity


   @test
   subroutine test_large_supports_maximum_test_degree_nine()
      integer(kind=4), parameter :: nelem = 1
      real(kind=8), parameter :: MASS(4) = (/1.d0, 0.d0, 0.d0, 0.d0/)
      integer(kind=4) :: n1, n2
      integer(kind=8) :: entries
      real(kind=8), allocatable :: actual(:, :), U1(:), U2(:)

      call make_open_knots(nelem, 9, n1, U1)
      call make_open_knots(nelem, 1, n2, U2)
      call assemble_large(U1, 9, n1, U2, 1, n2, nelem, &
                          MASS, MASS, MASS, actual, entries)

      @assertTrue(n1 == 9)
      @assertTrue(n2 == 1)
      @assertTrue(all(shape(actual) == (/12, 12/)))
      @assertTrue(entries == 44_8)
      @assertTrue(all(ieee_is_finite(actual)))
      @assertTrue(maxval(abs(actual - transpose(actual))) <= TOL)
      @assertTrue(abs(sum(actual(1:2, 1:2)) - 1.d0) <= TOL)
      @assertTrue(abs(sum(actual(1:2, 3:12)) - 1.d0) <= TOL)
      @assertTrue(abs(sum(actual(3:12, 1:2)) - 1.d0) <= TOL)
      @assertTrue(maxval(abs(actual(3:12, 3:12))) == 0.d0)
   end subroutine test_large_supports_maximum_test_degree_nine


   @test
   subroutine test_large_is_deterministic_with_openmp()
      integer(kind=4), parameter :: nelem = 12
      real(kind=8), parameter :: MASS(4) = (/1.d0, 0.d0, 0.d0, 0.d0/)
      integer(kind=4) :: i, n1, n2, split
      integer(kind=8) :: entries1, entries4
      real(kind=8) :: expected_sum, h
      real(kind=8), allocatable :: actual1(:, :), actual4(:, :), U1(:), U2(:)

      call make_open_knots(nelem, 2, n1, U1)
      call make_open_knots(nelem, 1, n2, U2)
      call omp_set_dynamic(.false.)
      call omp_set_num_threads(1)
      call assemble_large(U1, 2, n1, U2, 1, n2, nelem, &
                          MASS, MASS, MASS, actual1, entries1)
      call omp_set_num_threads(4)
      call assemble_large(U1, 2, n1, U2, 1, n2, nelem, &
                          MASS, MASS, MASS, actual4, entries4)
      call omp_set_num_threads(1)

      split = n2 + 1
      h = 1.d0/real(nelem, kind=8)
      @assertTrue(entries1 == 137_8)
      @assertTrue(entries4 == entries1)
      @assertTrue(all(actual1 == actual4))
      @assertTrue(maxval(abs(actual1 - transpose(actual1))) <= TOL)
      @assertTrue(maxval(abs(actual1(split + 1:, split + 1:))) == 0.d0)

      do i = 1, split
         expected_sum = h
         if (i == 1 .or. i == split) expected_sum = h/2.d0
         @assertTrue(abs(sum(actual1(i, :)) - 2.d0*expected_sum) <= TOL)
      end do
      do i = 1, n1 + 1
         expected_sum = h
         if (i == 1 .or. i == n1 + 1) expected_sum = h/3.d0
         if (i == 2 .or. i == n1) expected_sum = 2.d0*h/3.d0
         @assertTrue(abs(sum(actual1(split + i, :)) - expected_sum) <= TOL)
      end do
   end subroutine test_large_is_deterministic_with_openmp


   @test
   subroutine test_compute_matrix_selects_equal_space_path()
      integer(kind=8) :: entries
      real(kind=8) :: expected(2, 2)
      real(kind=8), allocatable :: actual(:, :)

      call exact_small_combination(expected)
      call compute_dense(U_QUADRATIC, 2, 2, 1, U_LINEAR, 1, 1, 1, &
                         (/1.d0, 2.d0, 3.d0, 4.d0/), &
                         (/50.d0, 60.d0, 70.d0, 80.d0/), &
                         (/90.d0, 100.d0, 110.d0, 120.d0/), .true., &
                         actual, entries)

      @assertTrue(entries == 4_8)
      @assertTrue(matrices_near(actual, expected))
   end subroutine test_compute_matrix_selects_equal_space_path


   @test
   subroutine test_compute_matrix_selects_mixed_space_path()
      integer(kind=8) :: entries
      real(kind=8) :: expected(5, 5)
      real(kind=8), allocatable :: actual(:, :)

      call exact_large_combination(expected)
      call compute_dense(U_QUADRATIC, 2, 2, 1, U_LINEAR, 1, 1, 1, &
                         (/1.d0, 2.d0, 3.d0, 4.d0/), &
                         (/5.d0, 6.d0, 7.d0, 8.d0/), &
                         (/9.d0, 10.d0, 11.d0, 12.d0/), .false., &
                         actual, entries)

      @assertTrue(entries == 16_8)
      @assertTrue(matrices_near(actual, expected))
   end subroutine test_compute_matrix_selects_mixed_space_path

end module test_operator_assembly
