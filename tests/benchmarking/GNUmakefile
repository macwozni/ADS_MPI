.DEFAULT_GOAL := all

PYTHON ?= python3
REPOSITORY_ROOT := $(abspath ../..)
BENCHMARKING_ROOT := $(REPOSITORY_ROOT)/benchmarking
CONFIG ?= $(REPOSITORY_ROOT)/m_options
CONFIG_PATH := $(abspath $(CONFIG))
MPIEXEC ?= /opt/lib/mpich-5.0.0/bin/mpiexec
MPIEXEC_FLAGS ?=
MPI_NP_FLAG ?= -n
SKIP_MPI_CASES ?= 0
BENCHMARK_INTEGRATION_TIMEOUT ?= 60
TEST_SCRIPTS := $(wildcard *.py)
PYTHON_ENV := env PYTHONDONTWRITEBYTECODE=1 \
	PYTHONPATH="$(BENCHMARKING_ROOT)" \
	ADS_BENCHMARK_TEST_CONFIG="$(CONFIG_PATH)" \
	MPIEXEC="$(MPIEXEC)" MPIEXEC_FLAGS="$(MPIEXEC_FLAGS)" \
	MPI_NP_FLAG="$(MPI_NP_FLAG)" SKIP_MPI_CASES="$(SKIP_MPI_CASES)" \
	BENCHMARK_INTEGRATION_TIMEOUT="$(BENCHMARK_INTEGRATION_TIMEOUT)"

.PHONY: all tests run clean

all:
	@$(PYTHON_ENV) $(PYTHON) -m py_compile $(TEST_SCRIPTS)

tests run: all
	@$(PYTHON_ENV) $(PYTHON) -m unittest discover -s . -p 'test_*.py' -v

clean:
	$(RM) -r -- __pycache__
