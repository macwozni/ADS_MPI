module test_reorder_rhs
   use pfunit
   use Setup, only: ADS_Setup
   use reorderRHS, only: ReorderRHSForX, ReorderRHSForY, ReorderRHSForZ, &
                         NormalizeTrialBufferToXYZ
   implicit none

   integer(kind=4), parameter :: XYZ(3) = (/1, 2, 3/)
   integer(kind=4), parameter :: YXZ(3) = (/2, 1, 3/)
   integer(kind=4), parameter :: ZXY(3) = (/3, 1, 2/)
   integer(kind=4), parameter :: OTHER_ORDERS(3, 3) = reshape((/ &
      1, 3, 2, &
      2, 3, 1, &
      3, 2, 1  &
   /), (/3, 3/))

contains

   pure real(kind=8) function encoded_value(ix, iy, iz) result(value)
      integer(kind=4), intent(in) :: ix, iy, iz

      value = 0.5d0 + 10000.d0*real(ix, kind=8) + &
              100.d0*real(iy, kind=8) + real(iz, kind=8)
   end function encoded_value


   subroutine allocate_layout(buffer, extents, order)
      real(kind=8), allocatable, intent(out) :: buffer(:, :)
      integer(kind=4), intent(in) :: extents(3), order(3)
      integer(kind=4) :: idx(3), ix, iy, iz, first, flattened

      allocate(buffer(extents(order(1)), extents(order(2))*extents(order(3))))
      buffer = -huge(1.d0)

      do iz = 0, extents(3) - 1
         do iy = 0, extents(2) - 1
            do ix = 0, extents(1) - 1
               idx = (/ix, iy, iz/)
               first = idx(order(1)) + 1
               flattened = idx(order(2)) + 1 + &
                           idx(order(3))*extents(order(2))
               buffer(first, flattened) = encoded_value(ix, iy, iz)
            end do
         end do
      end do
   end subroutine allocate_layout


   logical function cycle_matches(extents, ibeg) result(matches)
      integer(kind=4), intent(in) :: extents(3), ibeg(3)
      integer(kind=4) :: iend(3)
      real(kind=8), allocatable :: canonical(:, :), for_y(:, :)
      real(kind=8), allocatable :: for_z(:, :), restored(:, :)

      iend = ibeg + extents - 1
      call allocate_layout(canonical, extents, XYZ)
      allocate(for_y(extents(2), extents(1)*extents(3)))
      allocate(for_z(extents(3), extents(1)*extents(2)))
      allocate(restored(extents(1), extents(2)*extents(3)))
      for_y = -huge(1.d0)
      for_z = -huge(1.d0)
      restored = -huge(1.d0)

      call ReorderRHSForY(ibeg, iend, canonical, for_y)
      call ReorderRHSForZ(ibeg, iend, for_y, for_z)
      call ReorderRHSForX(ibeg, iend, for_z, restored)

      matches = all(restored == canonical)
   end function cycle_matches


   logical function normalization_matches(extents, order) result(matches)
      integer(kind=4), intent(in) :: extents(3), order(3)
      type(ADS_Setup) :: ads
      real(kind=8), allocatable :: actual(:, :), expected(:, :)

      ads%s = extents
      call allocate_layout(actual, extents, order)
      call allocate_layout(expected, extents, XYZ)

      call NormalizeTrialBufferToXYZ(ads, order, actual)

      matches = allocated(actual)
      if (.not. matches) return
      matches = size(actual, 1) == extents(1) .and. &
                size(actual, 2) == extents(2)*extents(3)
      if (.not. matches) return
      matches = all(actual == expected)
   end function normalization_matches


   @test
   subroutine test_reorder_for_y_maps_xyz_to_yxz()
      integer(kind=4), parameter :: extents(3) = (/2, 3, 4/)
      integer(kind=4), parameter :: ibeg(3) = (/-3, 5, 11/)
      integer(kind=4), parameter :: iend(3) = ibeg + extents - 1
      real(kind=8), allocatable :: actual(:, :), expected(:, :)
      real(kind=8), allocatable :: input(:, :), input_copy(:, :)

      call allocate_layout(input, extents, XYZ)
      call allocate_layout(expected, extents, YXZ)
      allocate(input_copy, source=input)
      allocate(actual(extents(2), extents(1)*extents(3)))
      actual = -huge(1.d0)

      call ReorderRHSForY(ibeg, iend, input, actual)

      @assertTrue(all(actual == expected))
      @assertTrue(all(input == input_copy))
   end subroutine test_reorder_for_y_maps_xyz_to_yxz


   @test
   subroutine test_reorder_for_z_maps_yxz_to_zxy()
      integer(kind=4), parameter :: extents(3) = (/2, 3, 4/)
      integer(kind=4), parameter :: ibeg(3) = (/-3, 5, 11/)
      integer(kind=4), parameter :: iend(3) = ibeg + extents - 1
      real(kind=8), allocatable :: actual(:, :), expected(:, :)
      real(kind=8), allocatable :: input(:, :), input_copy(:, :)

      call allocate_layout(input, extents, YXZ)
      call allocate_layout(expected, extents, ZXY)
      allocate(input_copy, source=input)
      allocate(actual(extents(3), extents(1)*extents(2)))
      actual = -huge(1.d0)

      call ReorderRHSForZ(ibeg, iend, input, actual)

      @assertTrue(all(actual == expected))
      @assertTrue(all(input == input_copy))
   end subroutine test_reorder_for_z_maps_yxz_to_zxy


   @test
   subroutine test_reorder_for_x_maps_zxy_to_xyz()
      integer(kind=4), parameter :: extents(3) = (/2, 3, 4/)
      integer(kind=4), parameter :: ibeg(3) = (/-3, 5, 11/)
      integer(kind=4), parameter :: iend(3) = ibeg + extents - 1
      real(kind=8), allocatable :: actual(:, :), expected(:, :)
      real(kind=8), allocatable :: input(:, :), input_copy(:, :)

      call allocate_layout(input, extents, ZXY)
      call allocate_layout(expected, extents, XYZ)
      allocate(input_copy, source=input)
      allocate(actual(extents(1), extents(2)*extents(3)))
      actual = -huge(1.d0)

      call ReorderRHSForX(ibeg, iend, input, actual)

      @assertTrue(all(actual == expected))
      @assertTrue(all(input == input_copy))
   end subroutine test_reorder_for_x_maps_zxy_to_xyz


   @test
   subroutine test_directional_reorders_form_an_exact_cycle()
      @assertTrue(cycle_matches((/5, 4, 3/), (/7, -4, 12/)))
   end subroutine test_directional_reorders_form_an_exact_cycle


   @test
   subroutine test_directional_reorders_handle_singleton_axes()
      @assertTrue(cycle_matches((/1, 3, 2/), (/-8, 6, 20/)))
      @assertTrue(cycle_matches((/2, 1, 4/), (/9, -3, 2/)))
      @assertTrue(cycle_matches((/1, 1, 1/), (/4, 5, 6/)))
   end subroutine test_directional_reorders_handle_singleton_axes


   @test
   subroutine test_normalize_identity_preserves_canonical_layout()
      @assertTrue(normalization_matches((/2, 3, 4/), XYZ))
   end subroutine test_normalize_identity_preserves_canonical_layout


   @test
   subroutine test_normalize_handles_production_axis_orders()
      @assertTrue(normalization_matches((/2, 3, 4/), YXZ))
      @assertTrue(normalization_matches((/2, 3, 4/), ZXY))
   end subroutine test_normalize_handles_production_axis_orders


   @test
   subroutine test_normalize_yxz_against_explicit_matrix()
      type(ADS_Setup) :: ads
      real(kind=8), allocatable :: actual(:, :), expected(:, :)

      ads%s = (/2, 3, 2/)
      allocate(actual(3, 4))
      actual(1, :) = (/1.d0, 2.d0, 101.d0, 102.d0/)
      actual(2, :) = (/11.d0, 12.d0, 111.d0, 112.d0/)
      actual(3, :) = (/21.d0, 22.d0, 121.d0, 122.d0/)
      allocate(expected(2, 6))
      expected(1, :) = (/1.d0, 11.d0, 21.d0, 101.d0, 111.d0, 121.d0/)
      expected(2, :) = (/2.d0, 12.d0, 22.d0, 102.d0, 112.d0, 122.d0/)

      call NormalizeTrialBufferToXYZ(ads, YXZ, actual)

      @assertTrue(all(shape(actual) == shape(expected)))
      @assertTrue(all(actual == expected))
   end subroutine test_normalize_yxz_against_explicit_matrix


   @test
   subroutine test_normalize_handles_other_axis_permutations()
      integer(kind=4) :: i

      do i = 1, size(OTHER_ORDERS, 2)
         @assertTrue(normalization_matches((/2, 3, 4/), OTHER_ORDERS(:, i)))
      end do
   end subroutine test_normalize_handles_other_axis_permutations


   @test
   subroutine test_normalize_handles_singleton_axes()
      @assertTrue(normalization_matches((/1, 3, 2/), YXZ))
      @assertTrue(normalization_matches((/2, 1, 4/), ZXY))
      @assertTrue(normalization_matches((/1, 1, 1/), OTHER_ORDERS(:, 3)))
   end subroutine test_normalize_handles_singleton_axes

end module test_reorder_rhs
