{
  "schema_version": 1,
  "name": "h-convergence-smoke",
  "description": "54-case spatial-cosine h-convergence smoke matrix with per-level dt/dt2 qualification pairs.",
  "family": "h",
  "exact_cases": ["spatial-cosine"],
  "problems": ["igrm_l2", "igrm_heat", "pure_diffusion_igrm"],
  "schemes": ["dg", "pr", "be"],
  "time_discretizations": [
    {"final_time": "0.01", "steps": 128},
    {"final_time": "0.01", "steps": 256}
  ],
  "meshes": [
    [2, 2, 2],
    [4, 4, 4],
    [8, 8, 8]
  ],
  "degree_pairs": [
    {"test": [3, 3, 3], "trial": [2, 2, 2]}
  ],
  "process_layouts": [
    {"ranks": 1, "grid": [1, 1, 1]}
  ],
  "thread_counts": [1],
  "sampling": {"points_per_axis": 33, "write_samples": true},
  "execution": {"warmups": 0, "samples": 1, "timeout_seconds": "1800"},
  "build_profiles": ["release"],
  "launcher": "mpi"
}
