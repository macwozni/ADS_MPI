{
  "schema_version": 1,
  "name": "p-anisotropic-smoke",
  "description": "108-case spatial-cosine anisotropic smoke matrix over three rotations of (3,4,5), both enrichments, and dt/dt2 pairs.",
  "family": "p",
  "exact_cases": ["spatial-cosine"],
  "problems": ["igrm_l2", "igrm_heat", "pure_diffusion_igrm"],
  "schemes": ["dg", "pr", "be"],
  "time_discretizations": [
    {"final_time": "0.01", "steps": 128},
    {"final_time": "0.01", "steps": 256}
  ],
  "meshes": [[2, 2, 2]],
  "degree_pairs": [
    {"test": [4, 5, 6], "trial": [3, 4, 5]},
    {"test": [5, 6, 7], "trial": [3, 4, 5]},
    {"test": [5, 6, 4], "trial": [4, 5, 3]},
    {"test": [6, 7, 5], "trial": [4, 5, 3]},
    {"test": [6, 4, 5], "trial": [5, 3, 4]},
    {"test": [7, 5, 6], "trial": [5, 3, 4]}
  ],
  "process_layouts": [
    {"ranks": 1, "grid": [1, 1, 1]}
  ],
  "thread_counts": [1],
  "sampling": {"points_per_axis": 33, "write_samples": true},
  "execution": {"warmups": 0, "samples": 1, "timeout_seconds": "1800"},
  "build_profiles": ["release"],
  "launcher": "mpi"
}
