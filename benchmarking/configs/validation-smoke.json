{
  "schema_version": 1,
  "name": "validation-smoke",
  "description": "36-case representative full-field validation matrix across MPI decompositions, OMP1/OMP4, and a dt/dt2 pair.",
  "family": "validation",
  "exact_cases": ["spatial-cosine"],
  "problems": ["igrm_l2"],
  "schemes": ["dg"],
  "time_discretizations": [
    {"final_time": "0.01", "steps": 128},
    {"final_time": "0.01", "steps": 256}
  ],
  "meshes": [[2, 2, 2]],
  "degree_pairs": [
    {"test": [3, 3, 3], "trial": [2, 2, 2]}
  ],
  "process_layouts": [
    {"ranks": 1, "grid": [1, 1, 1]},
    {"ranks": 2, "grid": [2, 1, 1]},
    {"ranks": 2, "grid": [1, 2, 1]},
    {"ranks": 2, "grid": [1, 1, 2]},
    {"ranks": 4, "grid": [2, 2, 1]},
    {"ranks": 4, "grid": [2, 1, 2]},
    {"ranks": 4, "grid": [1, 2, 2]},
    {"ranks": 8, "grid": [2, 2, 2]},
    {"ranks": 6, "grid": [3, 2, 1]}
  ],
  "thread_counts": [1, 4],
  "sampling": {"points_per_axis": 17, "write_samples": true},
  "execution": {"warmups": 0, "samples": 1, "timeout_seconds": "1800"},
  "build_profiles": ["release"],
  "launcher": "mpi"
}
